=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-t2)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-t2)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">两期内检测</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">里程周向长度深度</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">焊缝配准</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">五处里程差中位数</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">一对一匹配</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">加权代价贪心选取</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">未配准基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">原始里程最近邻</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">同一处缺陷才可比误差除以检测间隔</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">测量复核</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">两次测深与误配记录</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">增长率排序</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">深度差除以年数</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立参考</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">匹配正确率和增长误差</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 145\" role=\"img\" aria-label=\"统一坐标的数据流\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#365c4e\"><rect x=\"16\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#e2eeea\" stroke=\"#9ab5a8\"/><text x=\"98\" y=\"75\" text-anchor=\"middle\">首次里程 x₁</text><path d=\"M181 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"199\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#edf0e9\" stroke=\"#9ab5a8\"/><text x=\"281\" y=\"75\" text-anchor=\"middle\">二次里程 x₂</text><path d=\"M364 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"382\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#deeae4\" stroke=\"#9ab5a8\"/><text x=\"464\" y=\"75\" text-anchor=\"middle\">周向角与长度</text><path d=\"M547 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"565\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#f1eadc\" stroke=\"#9ab5a8\"/><text x=\"647\" y=\"75\" text-anchor=\"middle\">深度单位 mm</text></g></svg><figcaption>位置与毫米单位一致后才能跨期比较。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 145\" role=\"img\" aria-label=\"配准与匹配的数据流\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#365c4e\"><rect x=\"16\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#e2eeea\" stroke=\"#9ab5a8\"/><text x=\"98\" y=\"75\" text-anchor=\"middle\">五处稳定焊缝</text><path d=\"M181 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"199\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#edf0e9\" stroke=\"#9ab5a8\"/><text x=\"281\" y=\"75\" text-anchor=\"middle\">逐处里程差</text><path d=\"M364 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"382\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#deeae4\" stroke=\"#9ab5a8\"/><text x=\"464\" y=\"75\" text-anchor=\"middle\">中位数偏移 Δx</text><path d=\"M547 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"565\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#f1eadc\" stroke=\"#9ab5a8\"/><text x=\"647\" y=\"75\" text-anchor=\"middle\">校正二次坐标</text></g></svg><figcaption>排除整体里程偏移造成的错配。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 145\" role=\"img\" aria-label=\"增长与排序的数据流\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#365c4e\"><rect x=\"16\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#e2eeea\" stroke=\"#9ab5a8\"/><text x=\"98\" y=\"75\" text-anchor=\"middle\">里程+周向+长度</text><path d=\"M181 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"199\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#edf0e9\" stroke=\"#9ab5a8\"/><text x=\"281\" y=\"75\" text-anchor=\"middle\">一对一匹配</text><path d=\"M364 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"382\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#deeae4\" stroke=\"#9ab5a8\"/><text x=\"464\" y=\"75\" text-anchor=\"middle\">深度差 ÷ 年数</text><path d=\"M547 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"565\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#f1eadc\" stroke=\"#9ab5a8\"/><text x=\"647\" y=\"75\" text-anchor=\"middle\">到触发线年数</text></g></svg><figcaption>找到变化较快的复测候选。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 145\" role=\"img\" aria-label=\"独立评价的数据流\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#365c4e\"><rect x=\"16\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#e2eeea\" stroke=\"#9ab5a8\"/><text x=\"98\" y=\"75\" text-anchor=\"middle\">当前预测对应</text><path d=\"M181 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"199\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#edf0e9\" stroke=\"#9ab5a8\"/><text x=\"281\" y=\"75\" text-anchor=\"middle\">最后打开参考</text><path d=\"M364 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"382\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#deeae4\" stroke=\"#9ab5a8\"/><text x=\"464\" y=\"75\" text-anchor=\"middle\">匹配正确率</text><path d=\"M547 67h17l-5 -4m5 4l-5 4\" fill=\"none\" stroke=\"#678a7c\" stroke-width=\"2\"/><rect x=\"565\" y=\"35\" width=\"165\" height=\"65\" rx=\"8\" fill=\"#f1eadc\" stroke=\"#9ab5a8\"/><text x=\"647\" y=\"75\" text-anchor=\"middle\">增长率 MAE</text></g></svg><figcaption>分清配准收益与测量噪声。</figcaption></figure>"
      }
