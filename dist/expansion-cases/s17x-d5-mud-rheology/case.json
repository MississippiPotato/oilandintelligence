t [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>温度变了，固相和聚合物剂量如何共同影响塑性黏度？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"d5\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"钻井液性能调控：温度变化下寻找可行塑性黏度\"><defs><marker id=\"cf-d5\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-d5)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">流变实验批次</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">固相剂量温度与PV</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">分开实验批次</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">140训练与70留出</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">非线性响应面</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">拟合平方项与交互项</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">线性经验基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">同样实验条件比较</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">输入与场景是否对应？差异需要人工复核吗？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">筛选可行配方</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">温度和PV上下限</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">配方候选排序</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">目标偏差和相对成本</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">批次误差比较</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">留出PV的RMSE</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 分开实验批次</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 建立流变响应面</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 搜索可行配方</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 3</span><h3>分开实验批次</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>140批拟合，70批独立评价。</p></div><div class=\"table-scroll\"><table><caption>先把实验与留出分开（手算教学例）</caption><thead><tr><th>集合</th><th>独立批次数</th><th>用途</th></tr></thead><tbody><tr><td>训练</td><td>140</td><td>拟合响应面</td></tr><tr><td>留出</td><td>70</td><td>同批比较两种预测</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>批次RMSE</p></div><div><b>理解这一步</b><p>噪声控件改变留出批次的测量扰动。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 3</span><h3>建立流变响应面</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>拟合固相、剂量、温度及平方/交互项。</p></div><div class=\"table-scroll\"><table><caption>同斜率问题的单位换算（手算教学例）</caption><thead><tr><th>剪切速率 / s⁻¹</th><th>τ (YP=5 Pa, PV=20 mPa·s) / Pa</th></tr></thead><tbody><tr><td>0</td><td>5</td></tr><tr><td>500</td><td>15</td></tr><tr><td>1000</td><td>25</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>多项式系数与经验基线</p></div><div><b>理解这一步</b><p>在本例配方与温度范围内读取响应面。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 3</span><h3>搜索可行配方</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>扫描剂量和固相网格，筛选PV范围再排序。</p></div><div class=\"table-scroll\"><table><caption>可行性与目标代价分两步（手算教学例）</caption><thead><tr><th>候选PV</th><th>范围15—45 mPa·s</th><th>目标30的偏差</th></tr></thead><tbody><tr><td>12</td><td>排除</td><td>18</td></tr><tr><td>28</td><td>保留</td><td>2</td></tr><tr><td>50</td><td>排除</td><td>20</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>可行数量与候选剂量</p></div><div><b>理解这一步</b><p>可行集合为空时，显示冲突的目标区间与约束。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
      },
      "lessonHTML": "<div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>温度变了，固相和聚合物剂量如何共同影响塑性黏度？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"d5\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"钻井液性能调控：温度变化下寻找可行塑性黏度\"><defs><marker id=\"cf-d5\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-d5)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-d5)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">流变实验批次</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">固相剂量温度与PV</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">分开实验批次</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">140训练与70留出</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">非线性响应面</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">拟合平方项与交互项</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">线性经验基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">同样实验条件比较</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">输入与场景是否对应？差异需要人工复核吗？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">筛选可行配方</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">温度和PV上下限</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">配方候选排序</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">目标偏差和相对成本</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">批次误差比较</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">留出PV的RMSE</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 分开实验批次</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 建立流变响应面</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 搜索可行配方</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 3</span><h3>分开实验批次</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>140批拟合，70批独立评价。</p></div><div class=\"table-scroll\"><table><caption>先把实验与留出分开（手算教学例）</caption><thead><tr><th>集合</th><th>独立批次数</th><th>用途</th></tr></thead><tbody><tr><td>训练</td><td>140</td><td>拟合响应面</td></tr><tr><td>留出</td><td>70</td><td>同批比较两种预测</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>批次RMSE</p></div><div><b>理解这一步</b><p>噪声控件改变留出批次的测量扰动。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 3</span><h3>建立流变响应面</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>拟合固相、剂量、温度及平方/交互项。</p></div><div class=\"table-scroll\"><table><caption>同斜率问题的单位换算（手算教学例）</caption><thead><tr><th>剪切速率 / s⁻¹</th><th>τ (YP=5 Pa, PV=20 mPa·s) / Pa</th></tr></thead><tbody><tr><td>0</td><td>5</td></tr><tr><td>500</td><td>15</td></tr><tr><td>1000</td><td>25</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>多项式系数与经验基线</p></div><div><b>理解这一步</b><p>在本例配方与温度范围内读取响应面。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 3</span><h3>搜索可行配方</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>扫描剂量和固相网格，筛选PV范围再排序。</p></div><div class=\"table-scroll\"><table><caption>可行性与目标代价分两步（手算教学例）</caption><thead><tr><th>候选PV</th><th>范围15—45 mPa·s</th><th>目标30的偏差</th></tr></thead><tbody><tr><td>12</td><td>排除</td><td>18</td></tr><tr><td>28</td><td>保留</td><td>2</td></tr><tr><td>50</td><td>排除</td><td>20</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>可行数量与候选剂量</p></div><div><b>理解这一步</b><p>可行集合为空时，显示冲突的目标区间与约束。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
