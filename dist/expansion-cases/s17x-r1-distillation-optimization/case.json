=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-r1)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-r1)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立工况</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">三项操作与三项测量</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">锁定分组</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">一百一十二训四十八测</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">二次回归</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">拟合回收率能耗终馏点</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">两条基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">固定操作点与训练均值</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">预测可行不等于实测空可行域也保留</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">约束筛选</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">能耗和终馏点上限</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">网格推荐</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">九百六十一候选搜索</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立检验</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">留出误差与推荐限制</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 170\" role=\"img\" aria-label=\"整理独立工况：每条记录的输入、结果和单位明确。\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"16\" fill=\"#233d46\"><rect x=\"15\" y=\"55\" width=\"170\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"100.0\" y=\"91.0\" text-anchor=\"middle\">训练批次</text><path d=\"M185 85 L245 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M239 81L245 85L239 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"245\" y=\"55\" width=\"185\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"337.5\" y=\"91.0\" text-anchor=\"middle\">输入与同批测量</text><path d=\"M430 85 L490 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M484 81L490 85L484 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"490\" y=\"55\" width=\"220\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"600.0\" y=\"91.0\" text-anchor=\"middle\">留出批次另行评价</text></g></svg><figcaption>整理独立工况：每条记录的输入、结果和单位明确。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 170\" role=\"img\" aria-label=\"拟合并检查三个代理：得到可重复计算的系数和各指标MAE。\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"16\" fill=\"#233d46\"><rect x=\"25\" y=\"55\" width=\"175\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"112.5\" y=\"91.0\" text-anchor=\"middle\">温度 / 操作 / 原料</text><path d=\"M200 85 L255 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M249 81L255 85L249 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"255\" y=\"55\" width=\"200\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"355.0\" y=\"91.0\" text-anchor=\"middle\">拟合回归系数</text><path d=\"M455 85 L505 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M499 81L505 85L499 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"505\" y=\"55\" width=\"220\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"615.0\" y=\"91.0\" text-anchor=\"middle\">各输出分别预测</text></g></svg><figcaption>拟合并检查三个代理：得到可重复计算的系数和各指标MAE。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 170\" role=\"img\" aria-label=\"筛选可行域：可行与越界候选在二维图上分开。\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"16\" fill=\"#233d46\"><rect x=\"25\" y=\"55\" width=\"185\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"117.5\" y=\"91.0\" text-anchor=\"middle\">原始候选结果</text><path d=\"M210 85 L270 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M264 81L270 85L264 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"270\" y=\"55\" width=\"190\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"365.0\" y=\"91.0\" text-anchor=\"middle\">约束检查</text><path d=\"M460 85 L520 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M514 81L520 85L514 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"520\" y=\"55\" width=\"205\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"622.5\" y=\"91.0\" text-anchor=\"middle\">可用结果 / 越界</text></g></svg><figcaption>筛选可行域：可行与越界候选在二维图上分开。</figcaption></figure><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 170\" role=\"img\" aria-label=\"比较并解释推荐点：得到条件明确的候选方案和基线差异。\"><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"16\" fill=\"#233d46\"><rect x=\"20\" y=\"55\" width=\"190\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"115.0\" y=\"91.0\" text-anchor=\"middle\">模型输出</text><path d=\"M210 85 L270 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M264 81L270 85L264 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"270\" y=\"55\" width=\"180\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"360.0\" y=\"91.0\" text-anchor=\"middle\">与基线比较</text><path d=\"M450 85 L510 85\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"3\"/><path d=\"M504 81L510 85L504 89\" fill=\"none\" stroke=\"#377e7a\" stroke-width=\"2\"/><rect x=\"510\" y=\"55\" width=\"220\" height=\"60\" rx=\"8\" fill=\"#e1efed\" stroke=\"#8eb4af\"/><text x=\"620.0\" y=\"91.0\" text-anchor=\"middle\">误差 / 条件 / 复核</text></g></svg><figcaption>比较并解释推荐点：得到条件明确的候选方案和基线差异。</figcaption></figure>"
      }
