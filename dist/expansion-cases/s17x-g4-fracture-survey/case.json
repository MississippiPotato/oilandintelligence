l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>从岩体裂缝到图像线段，区分地质对象与检测结果。</p><p>岩石破裂形成裂缝；在二维露头照片上看到的是裂缝面与露头面的交线，称为迹线。开放、连通的裂缝可能形成流体通道，矿物充填的裂缝也可能阻碍流动。因此先记录几何，再结合充填、开度和连通性讨论储层，将几何、充填、开度与连通性一同解释。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 230\" role=\"img\" aria-label=\"露头裂缝迹线与储层渗流\"><rect width=\"700\" height=\"230\" rx=\"12\" fill=\"#f5f8f7\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"17\" fill=\"#24414a\"><rect x=\"32\" y=\"40\" width=\"270\" height=\"135\" fill=\"#d9ccb1\"/><path d=\"M75 40l45 135M170 40l45 135M32 135l270-65\" stroke=\"#375a61\" stroke-width=\"4\"/><path d=\"M90 85l90 28\" stroke=\"#277fb0\" stroke-width=\"4\"/><text x=\"45\" y=\"207\">露头平面上只看到裂缝与表面的交线</text><text x=\"347\" y=\"70\">裂缝：岩石的破裂面</text><text x=\"347\" y=\"110\">迹线：破裂面在露头上的交线</text><text x=\"347\" y=\"150\">可能增大连通性，也可能被矿物充填</text><text x=\"347\" y=\"193\">还需了解开度、充填和连通关系</text></g></svg><figcaption>裂缝能影响储层流动路径；这张图解释迹线的含义，先认识裂缝面在观察平面上的迹线。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "MEASURE",
          "title": "测量裂缝，必须同时说明观察窗口",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>看清扫描线和面积窗口，P10与P21的分母不同。</p><p>本例窗口宽12 m、高8 m，像素标尺为0.1 m。P21使用窗口内部所有提取迹线的长度之和除以96 m²；P10使用水平扫描线与迹线的交点数除以12 m。移动扫描线会改变交点数，窗口整体的P21则不变。迹线方向是相对于照片水平轴的0–180°角，以照片水平轴为角度基准。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 230\" role=\"img\" aria-label=\"P21 和 P10 的统计分母不同\"><rect width=\"700\" height=\"230\" rx=\"12\" fill=\"#f5f8f7\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"17\" fill=\"#24414a\"><rect x=\"35\" y=\"35\" width=\"260\" height=\"145\" fill=\"#f2e7d1\" stroke=\"#a5bcb6\"/><path d=\"M70 35l60 145M160 35l60 145M35 140l260-75\" stroke=\"#375a61\" stroke-width=\"3\"/><path d=\"M35 110h260\" stroke=\"#c17833\" stroke-width=\"3\" stroke-dasharray=\"7 4\"/><text x=\"350\" y=\"65\">P21 = 迹线总长度 / 窗口面积</text><text x=\"350\" y=\"105\">单位 m / m² = m⁻¹</text><text x=\"350\" y=\"150\">P10 = 扫描线交点数 / 扫描线长度</text><text x=\"350\" y=\"190\">单位 个 / m；与扫描线方向有关</text></g></svg><figcaption>窗口边界截断的迹线只计窗口内部长度。P10按扫描线长度作分母，P21按窗口面积作分母。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "METHOD",
          "title": "图像方法怎样找线，怎样知道找错了",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>对照检出线和图像边缘，判断是漏掉弱裂缝还是接入了噪声。</p><p>灰度阈值选出暗像素，每个像素向多种候选法向角和距离投票；同一直线上的像素会在Hough参数空间聚集。取高票峰并压制相近峰，得到直线候选。演示图由4条贯穿窗口的直线加噪声构成；模型只读取灰度图，参考几何留到评价时进行一对一匹配。短小、弯曲或交叉密集的迹线适合通过原图叠加检查。</p></div>"
        },
        {
          "no": 4,
          "en": "READ_AND_TEST",
          "title": "把P10和P21当作两种不同的取样问题",
          "html": "<div class=\"xl-knowledge\"><p>灰度图上的青色L编号与逐线表一一对应；表内长度只计12m×8m照片窗口内的部分。玫瑰图统计每15°内的迹线条数，画两侧是同一条无向迹线的对称表示，每条无向迹线按一条计数。灰度阈值越高，入选暗像素越多；最低票数越高，直线候选要求越严格，分别比较像素入选与直线得票两个环节。</p><p><b>保持提取条件，移动扫描线：</b>运行后点击照片上、中、下位置，比较逐线表与P21是否保持，P10是否随交点数变化。扫描线控件表示从照片上边界向下的距离，单位m。P10=交点数/12m；P21=迹线总长度/96m²。此合成图的四条迹线贯穿窗口，某些扫描线位置交点数可能相同，这也应如实保留。再提高最低票数，定位哪条L候选消失及长度分母是否改变。二维迹线角描述照片平面内的方向，配合逐线长度理解几何分布。</p></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>裂缝条数和裂缝总长度回答不同问题；统计之前，要先说明观察窗口与检出的线段。</h2><p>从一个露头观察窗口出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>裂缝为什么值得在勘察阶段记录</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>测量裂缝，必须同时说明观察窗口</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>图像方法怎样找线，怎样知道找错了</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "从观测到可核查结果",
      "lead": [
        "在限定露头窗口内提取裂缝迹线，说明方向分布、单位面积迹线长度，以及扫描线统计为何依赖位置。"
      ],
      "steps": [
        {
          "name": "选择窗口与暗像素",
          "role": "数据",
          "do": "调节灰度阈值、噪声和裂缝对比度，观察哪些像素进入投票。",
          "effect": "固定比例尺的二维灰度观测和阈值掩膜。",
          "trap": "从暗像素入选，再回查迹线形状与露头结构。"
        },
        {
          "name": "Hough投票提取直线",
          "role": "方法",
          "do": "每5°扫描法向角，按2像素距离分箱；设置最低票数并去除相近重复峰。",
          "effect": "最多8条窗口内直线段和每条票数。",
          "trap": "直线模型提取窗口内贯穿迹线，长度按窗口范围统计。"
        },
        {
          "name": "统计与对照核查",
          "role": "解释",
          "do": "裁剪到窗口后测长，画15°分箱的方向玫瑰图；移动扫描线计算P10。",
          "effect": "P21、P10、逐线长度及与固定严格基线的F1比较。",
          "trap": "窗口内长度、参考匹配容差与预测一起保存。"
        }
      ],
      "metrics": {
        "title": "步骤图解与统计口径",
        "html": "<style>/* Applied only to the56 expansion lessons; data-category colors are preserved. */\n.xl-lesson,.xl-parent{--xl-red:#b8242a;--xl-paper:#f7f4ef;--xl-ink:#292d34;--xl-muted:#66717d;--xl-line:#e6dfd7;color:var(--xl-ink);font-size:18px;line-height:1.85}\nbody.xl-lesson{margin:0;background:var(--xl-paper);font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}\n.xl-lesson>header{max-width:1180px;margin:28px auto 0;padding:32px 38px 20px;background:#fff;border:1px solid var(--xl-line);border-radius:24px;box-shadow:0 8px 30px #3b282608}\n.xl-lesson>header h1{color:#292d34;font-size:clamp(25px,2.6vw,36px);line-height:1.5;max-width:1000px;margin:12px 0}\n.xl-lesson>main{max-width:1180px;margin:24px auto 70px;padding:0 0 25px;min-width:0}\n.xl-lesson>header nav{position:static;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;padding:14px 0 0;margin:14px 0 0}\n.xl-lesson>nav{max-width:1180px;margin:18px auto;padding:0 10px;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;position:static}\n.xl-lesson>nav button[aria-selected=\"true\"]{background:var(--xl-red);border-color:var(--xl-red);color:white}\n.xl-lesson>header nav button,.xl-lesson button,.xl-parent button{font:inherit;line-height:1.5;min-height:44px;cursor:pointer}\n.xl-lesson button,.xl-parent .xl-step-nav button,.xl-parent .xl-next button{background:#fff;color:#4d4343;border:1px solid #ddd5d0;border-radius:13px;padding:10px 17px;transition:background .15s,border-color .15s,box-shadow .15s}\n.xl-lesson button:hover,.xl-parent .xl-step-nav button:hover{border-color:var(--xl-red);background:#fff8f5}\n.xl-lesson button.primary,.xl-lesson button.active,.xl-lesson header nav button[aria-pressed=\"true\"],.xl-lesson header nav button[aria-selected=\"true\"],.xl-step-nav button[aria-selected=\"true\"],.xl-parent .xl-next button{background:var(--xl-red);color:white;border-color:var(--xl-red)}\n.xl-lesson button:disabled{opacity:.45;cursor:default}\n.xl-lesson :focus-visible,.xl-parent :focus-visible{outline:3px solid #b8242a88;outline-offset:4px}\n.xl-lesson input,.xl-lesson select,.xl-lesson textarea{font:inherit;min-width:0;max-width:100%;accent-color:var(--xl-red);border-radius:9px}\n.xl-lesson input[type=range]{width:100%}.xl-lesson label{font-size:17px;color:#45434a}\n.xl-lesson p{max-width:100%;overflow-wrap:anywhere}\n.xl-lesson .intro,.xl-lesson .note,.xl-lesson .small,.xl-lesson .data-note,.xl-lesson .legend,.xl-lesson figcaption,.xl-parent figcaption,.xl-parent .note{font-size:16px;line-height:1.8;color:#64707a}\n.xl-lesson .source-badge,.xl-kicker{font-size:13px;letter-spacing:.1em;color:var(--xl-red);font-weight:700;text-transform:uppercase}\n.xl-lesson .brand,.xl-lesson .eyebrow,.xl-lesson .tag,.xl-lesson .kicker,.xl-lesson output,.xl-lesson>header a{color:var(--xl-red)}\n.xl-parent #tabs .tab.on{background:var(--xl-red);border-color:var(--xl-red);color:#fff}\n.xl-lesson h2,.xl-parent .xl-opening h2{font-size:25px;line-height:1.55;color:#292d34;margin:12px 0 20px}\n.xl-lesson h3{font-size:21px;color:#333842;line-height:1.55}\n.xl-lesson .card,.xl-lesson .panel,.xl-lesson .reading-block,.xl-lesson .plot-grid>article,.xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide{background:#fff;border:1px solid var(--xl-line);border-radius:20px;box-shadow:0 5px 22px #382b2105;padding:26px 30px;margin:20px 0}\n.xl-opening{padding:28px 32px;background:linear-gradient(120deg,#fff 60%,#fff3ed)}\n.xl-opening h2{max-width:960px;font-size:27px;font-weight:650;line-height:1.65}\n.xl-opening>p{margin-bottom:0;color:var(--xl-muted)}\n.xl-reading-path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0 2px}\n.xl-reading-path a{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;background:#fff;border:1px solid #ece3dd;border-radius:14px;color:#4d4343;text-decoration:none;line-height:1.6;font-size:16px}\n.xl-reading-path a span{font-size:13px;color:var(--xl-red);font-weight:750}\n.xl-read{padding:13px 17px;border-left:3px solid var(--xl-red);background:#fbf6f1;color:#5d4f49;font-size:16px;line-height:1.8;border-radius:0 10px 10px 0}\n.xl-read b{display:block;color:var(--xl-red);font-size:13px;letter-spacing:.05em;margin-bottom:4px}\n.xl-chapter{scroll-margin-top:22px}\n.xl-knowledge>p{margin:20px 0}.xl-knowledge>p.xl-read{margin:0 0 22px}\n.xl-knowledge figure{margin:24px 0}.xl-knowledge svg,.xl-method-step svg{display:block;width:100%;max-width:900px;max-height:280px;height:auto;margin:18px auto}\n.xl-knowledge img{max-width:100%;height:auto;border-radius:12px}\n.xl-diagram,.xl-data-plot{max-width:100%;min-width:0;overflow:auto}.xl-diagram-hint{display:none}\n.xl-method>.case-flow-overview,.xl-parent .case-flow-overview{margin:20px 0;background:#fff;border:1px solid var(--xl-line);border-radius:20px;padding:20px;box-shadow:none}\n.xl-method .case-flow-overview svg{max-height:300px;width:100%;height:auto}\n.xl-step-nav{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 14px}\n.xl-step-nav button{font-size:16px;border-radius:12px;padding:10px 13px}\n.xl-step-heading{display:flex;align-items:center;gap:18px;margin-bottom:18px}.xl-step-heading h3{margin:0;font-size:24px}\n.xl-action-copy>b,.xl-products b{font-size:14px;color:var(--xl-red)}.xl-action-copy p{margin:7px 0 24px}\n.xl-products{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--xl-line);padding-top:18px;margin-top:22px}\n.xl-products p{font-size:17px;margin:7px 0}.xl-next{display:flex;justify-content:flex-end;margin:22px 0}\n.xl-lab-guide{border-top:3px solid var(--xl-red);padding:22px 28px}\n.xl-lab-guide h2{margin:4px 0 10px;font-size:23px}.xl-lab-guide>p{margin:8px 0 16px;color:#645f61;font-size:17px}\n.xl-task-actions{display:flex;gap:10px;flex-wrap:wrap}.xl-task-actions button{font-size:16px}\n.xl-task-actions button[aria-pressed=\"true\"]{background:#fbebeb;border-color:#c27b7e;color:#9c2026}\n.xl-task-look{padding-top:14px;border-top:1px solid var(--xl-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>从观测到可核查结果</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"g4\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"从露头迹线到裂缝强度\"><defs><marker id=\"cf-g4\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-g4)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g4)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">露头窗口</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">12m乘8m灰度图</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">灰度分割</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">阈值筛选暗像素</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">Hough提取</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">角度距离投票去重</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">严格取峰</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">70票且最多2条</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">先核查阴影与层理再解释裂缝连通性</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">叠加核查</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">逐线位置与方向</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">裂缝统计</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">P21与扫描线P10</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">几何匹配</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">角度距离容差下F1</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 选择窗口与暗像素</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 Hough投票提取直线</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 统计与对照核查</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 3</span><h3>选择窗口与暗像素</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>调节灰度阈值、噪声和裂缝对比度，观察哪些像素进入投票。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 220\" role=\"img\" aria-label=\"灰度阈值决定哪些像素参与投票\"><rect width=\"700\" height=\"220\" rx=\"12\" fill=\"#f5f8f7\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#24414a\"><rect x=\"35\" y=\"45\" width=\"210\" height=\"115\" fill=\"#b8b8b8\"/><path d=\"M65 45l70 115M35 135l210-55\" stroke=\"#353535\" stroke-width=\"5\"/><path d=\"M275 102h65\" stroke=\"#568379\" stroke-width=\"3\"/><rect x=\"370\" y=\"45\" width=\"210\" height=\"115\" fill=\"#fff\" stroke=\"#b2c9c1\"/><path d=\"M400 45l70 115M370 135l210-55\" stroke=\"#222\" stroke-width=\"4\"/><text x=\"35\" y=\"202\">原灰度图</text><text x=\"370\" y=\"202\">灰度小于阈值 → 暗像素掩膜</text></g></svg><figcaption>提高阈值会纳入更多暗点；灰度差异过小时，噪声与裂缝可能混在一起。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>固定比例尺的二维灰度观测和阈值掩膜。</p></div><div><b>理解这一步</b><p>从暗像素入选，再回查迹线形状与露头结构。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 3</span><h3>Hough投票提取直线</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>每5°扫描法向角，按2像素距离分箱；设置最低票数并去除相近重复峰。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 220\" role=\"img\" aria-label=\"像素共线在参数空间形成投票峰\"><rect width=\"700\" height=\"220\" rx=\"12\" fill=\"#f5f8f7\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#24414a\"><path d=\"M70 170V30m0 140h540\" stroke=\"#9bb9af\" fill=\"none\"/><text x=\"15\" y=\"25\">票数</text><text x=\"492\" y=\"204\">候选直线参数</text><path d=\"M90 164L130 154L160 158L185 45L210 160L280 150L320 75L350 164L395 100L420 163L470 55L500 165L570 157\" stroke=\"#2c7a6a\" fill=\"none\" stroke-width=\"3\"/><path d=\"M70 125h540\" stroke=\"#be8035\" stroke-width=\"2\" stroke-dasharray=\"7 5\"/><text x=\"490\" y=\"116\">最低票数</text></g></svg><figcaption>这是投票峰原理示意；本次提取的真实票数在逐线表显示。过低阈值会带入弱假峰，过高会漏线。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>最多8条窗口内直线段和每条票数。</p></div><div><b>理解这一步</b><p>直线模型提取窗口内贯穿迹线，长度按窗口范围统计。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 3</span><h3>统计与对照核查</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>裁剪到窗口后测长，画15°分箱的方向玫瑰图；移动扫描线计算P10。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 220\" role=\"img\" aria-label=\"面积统计和扫描线统计各保留分母\"><rect width=\"700\" height=\"220\" rx=\"12\" fill=\"#f5f8f7\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#24414a\"><text x=\"35\" y=\"58\">窗口内迹线总长 ÷ 96 m²</text><path d=\"M35 78h300\" stroke=\"#2d7b6e\" stroke-width=\"3\"/><text x=\"35\" y=\"112\">P21：同一组迹线的面积强度</text><text x=\"365\" y=\"58\">扫描线交点数 ÷ 12 m</text><path d=\"M365 78h300\" stroke=\"#bf8136\" stroke-width=\"3\"/><text x=\"365\" y=\"112\">P10：这条扫描线的交切频率</text><text x=\"35\" y=\"177\">移动扫描线：P10可能改变，P21保持不变</text></g></svg><figcaption>分别查看方向分箱与交点数。提取错误会传入几何统计，应该先核查叠加图再解释。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>P21、P10、逐线长度及与固定严格基线的F1比较。</p></div><div><b>理解这一步</b><p>窗口内长度、参考匹配容差与预测一起保存。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
