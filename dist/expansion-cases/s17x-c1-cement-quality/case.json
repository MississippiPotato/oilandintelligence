ill=\"rgb(110,140,145)\"/><rect x=\"784\" y=\"146\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"800\" y=\"146\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"816\" y=\"146\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"560\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"576\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"592\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"608\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"624\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"640\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"656\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"672\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"688\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"704\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"720\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"736\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"752\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"768\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"784\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"800\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"816\" y=\"173\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"560\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"576\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"592\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"608\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"624\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"640\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"656\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"672\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"688\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"704\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"720\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"736\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><rect x=\"752\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(130,160,165)\"/><rect x=\"768\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(150,180,185)\"/><rect x=\"784\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(170,200,205)\"/><rect x=\"800\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(90,120,125)\"/><rect x=\"816\" y=\"200\" width=\"17\" height=\"27\" fill=\"rgb(110,140,145)\"/><text x=\"548\" y=\"42\" font-size=\"17\" fill=\"#223e46\">VDL：每个深度的一整条波形</text><text x=\"560\" y=\"267\" font-size=\"17\" fill=\"#223e46\">时间 →；深度向下增加</text><text x=\"40\" y=\"310\" font-size=\"18\" fill=\"#223e46\">早到幅度压缩为一维曲线；VDL 同时呈现套管波、后到波与波列变化。</text></g></svg><figcaption>传统 CBL 测量套管波幅或衰减；VDL 用灰度或颜色显示完整波形随深度的变化。演示以合成归一化声幅保留两类信息，不把灰度直接称为胶结强度。</figcaption></figure>"
        },
        {
          "no": 3,
          "en": "CONCEPT",
          "title": "图 B3｜幅度相同，原因可能不同：加入后到波证据",
          "html": "<figure><svg viewBox=\"0 0 880 310\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"微环空和弱胶结可能有相近早到波幅\"><rect width=\"880\" height=\"310\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"35\" y=\"35\" width=\"355\" height=\"50\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"66.0\" font-size=\"19\" fill=\"#223e46\">A：胶结较好 + 微环空</text><rect x=\"490\" y=\"35\" width=\"355\" height=\"50\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"505\" y=\"66.0\" font-size=\"19\" fill=\"#223e46\">B：弱胶结响应</text><path d=\"M45 170h330M500 170h330\" stroke=\"#b4c4c3\"/><path d=\"M65 170q15 -90 30 0t30 0t30 0M520 170q15 -90 30 0t30 0t30 0\" fill=\"none\" stroke=\"#bc8750\" stroke-width=\"3\"/><path d=\"M230 170q16 -60 32 0t32 0t32 0M685 170q16 -15 32 0t32 0t32 0\" fill=\"none\" stroke=\"#347f80\" stroke-width=\"3\"/><text x=\"70\" y=\"220\" font-size=\"17\" fill=\"#223e46\">早到波：较强</text><text x=\"225\" y=\"220\" font-size=\"17\" fill=\"#223e46\">后到波：明显</text><text x=\"525\" y=\"220\" font-size=\"17\" fill=\"#223e46\">早到波：较强</text><text x=\"680\" y=\"220\" font-size=\"17\" fill=\"#223e46\">后到波：较弱</text><text x=\"40\" y=\"278\" font-size=\"18\" fill=\"#223e46\">对照实验：只改变微环空扰动，比较“仅声幅阈值”与“多特征近邻”。</text></g></svg><figcaption>CBL 对微环空敏感。VDL 中的后到波可提供额外线索，但快地层、偏心与噪声仍会干扰。本例学习三种教学响应类型，并把低支持度样本交给人工复核。</figcaption></figure>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "沿着井深，把声学响应变成可以复核的胶结判断",
      "lead": [
        "观察套管波幅与后到波列，比较单声幅阈值和多特征近邻；亲手加入微环空、偏心或噪声，查看哪些深度需要补充证据。"
      ],
      "steps": [
        {
          "name": "看清观测与采样窗口",
          "role": "图 S1",
          "do": "输入：每井 48 个深度点；每点 80 个声幅采样；动作：按 0.5 m 采样间隔对齐声幅与波列；固定早到窗、后到窗。见图 S1。",
          "effect": "带 sampleId / 井号 / MD 的可见波形",
          "trap": "横轴是传播时间，纵轴是测量深度；二者不能互换。"
        },
        {
          "name": "先按整井分组，再学习",
          "role": "图 S2",
          "do": "输入：18 口训练井、6 口验证井、4 口测试井；动作：同一井的全部深度点只进入一个集合；测试扰动仅作用于测试井。见图 S2。",
          "effect": "864 / 288 / 192 个采样点，井号互不重叠",
          "trap": "邻近深度点高度相似，随机拆点会把同一条曲线泄漏到测试。"
        },
        {
          "name": "从波形计算四维特征",
          "role": "图 S3",
          "do": "输入：当前可见波形，不含类别字段；动作：计算早到 RMS、后到 RMS、后/早 RMS 比、后到一阶差分 RMS。见图 S3。",
          "effect": "可解释的声幅强弱、波列能量与起伏特征",
          "trap": "波形由教学生成器产生；分类器不能读取生成器内部的胶结类别。"
        },
        {
          "name": "真实近邻投票与拒判",
          "role": "图 S4",
          "do": "输入：训练标准化参数、训练特征库、当前四维特征；动作：验证集从 k=3/5/9 选优；按距离倒数加权投票。见图 S4。",
          "effect": "响应类型、实际近邻、投票支持度与待复核原因",
          "trap": "投票支持度不是现场概率；平均邻距超过 4.5 或低于支持度门槛时拒判。"
        },
        {
          "name": "同井对照、误差定位与复核",
          "role": "图 S5",
          "do": "输入：模型/阈值预测；独立评价真值仅用于计分；动作：在同一 192 点上计算带拒判列的混淆矩阵；保留人工意见。见图 S5。",
          "effect": "宏 F1、每类召回、覆盖率、接受集错误率、当前证据 JSON",
          "trap": "拒判保留在总分母；人工意见单独保存，不修改模型原始成绩。"
        }
      ],
      "metrics": {
        "title": "逐步骤图解与评价口径",
        "html": "<figure><h3>图 S1｜看清观测与采样窗口</h3><svg viewBox=\"0 0 880 220\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"深度与波形采样\"><rect width=\"880\" height=\"220\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"25\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"40\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">井号与深度</text><path d=\"M184 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"30\" y=\"166\" font-size=\"16\" fill=\"#223e46\">m MD</text><rect x=\"198\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"213\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">80点波形</text><path d=\"M357 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"203\" y=\"166\" font-size=\"16\" fill=\"#223e46\">归一化声幅</text><rect x=\"371\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"386\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">早到窗</text><path d=\"M530 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"376\" y=\"166\" font-size=\"16\" fill=\"#223e46\">10–36点</text><rect x=\"544\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">后到窗</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">42–74点</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">可见特征</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">4维输入</text></g></svg><figcaption>输入：每井 48 个深度点；每点 80 个声幅采样；动作：按 0.5 m 采样间隔对齐声幅与波列；固定早到窗、后到窗；产物：带 sampleId / 井号 / MD 的可见波形。横轴是传播时间，纵轴是测量深度；二者不能互换。</figcaption></figure><figure><h3>图 S2｜先按整井分组，再学习</h3><svg viewBox=\"0 0 880 240\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"整井隔离数据划分\"><rect width=\"880\" height=\"240\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"35\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">训练：18井 / 864点</text><rect x=\"315\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"330\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">验证：6井 / 288点</text><rect x=\"595\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"610\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">测试：4井 / 192点</text><text x=\"55\" y=\"195\" font-size=\"19\" fill=\"#223e46\">拟合均值、尺度和样本库</text><text x=\"335\" y=\"195\" font-size=\"19\" fill=\"#223e46\">选择 k 和基线阈值</text><text x=\"615\" y=\"195\" font-size=\"19\" fill=\"#223e46\">只推理，再独立评分</text></g></svg><figcaption>输入：18 口训练井、6 口验证井、4 口测试井；动作：同一井的全部深度点只进入一个集合；测试扰动仅作用于测试井；产物：864 / 288 / 192 个采样点，井号互不重叠。邻近深度点高度相似，随机拆点会把同一条曲线泄漏到测试。</figcaption></figure><figure><h3>图 S3｜从波形计算四维特征</h3><svg viewBox=\"0 0 880 250\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"四种实际计算特征\"><rect width=\"880\" height=\"250\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"35\" y=\"40\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"78.5\" font-size=\"19\" fill=\"#223e46\">早到 RMS = √mean(a²)</text><rect x=\"485\" y=\"40\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"500\" y=\"78.5\" font-size=\"19\" fill=\"#223e46\">后到 RMS = √mean(b²)</text><rect x=\"35\" y=\"145\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"183.5\" font-size=\"19\" fill=\"#223e46\">相对能量 = RMS(b) / RMS(a)</text><rect x=\"485\" y=\"145\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"500\" y=\"183.5\" font-size=\"19\" fill=\"#223e46\">起伏 = √mean((bₜ − bₜ₋₁)²)</text></g></svg><figcaption>输入：当前可见波形，不含类别字段；动作：计算早到 RMS、后到 RMS、后/早 RMS 比、后到一阶差分 RMS；产物：可解释的声幅强弱、波列能量与起伏特征。波形由教学生成器产生；分类器不能读取生成器内部的胶结类别。</figcaption></figure><figure><h3>图 S4｜真实近邻投票与拒判</h3><svg viewBox=\"0 0 880 220\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"近邻分类\"><rect width=\"880\" height=\"220\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"25\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"40\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">训练标准化</text><path d=\"M184 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"30\" y=\"166\" font-size=\"16\" fill=\"#223e46\">训练拟合</text><rect x=\"198\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"213\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">全4维距离</text><path d=\"M357 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"203\" y=\"166\" font-size=\"16\" fill=\"#223e46\">欧氏距离</text><rect x=\"371\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"386\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">k个近邻</text><path d=\"M530 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"376\" y=\"166\" font-size=\"16\" fill=\"#223e46\">验证选k</text><rect x=\"544\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">加权投票</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">1/max(0.05,d)</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">复核门槛</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">支持度/距离</text></g></svg><figcaption>输入：训练标准化参数、训练特征库、当前四维特征；动作：验证集从 k=3/5/9 选优；按距离倒数加权投票；产物：响应类型、实际近邻、投票支持度与待复核原因。投票支持度不是现场概率；平均邻距超过 4.5 或低于支持度门槛时拒判。</figcaption></figure><figure><h3>图 S5｜同井对照、误差定位与复核</h3><svg viewBox=\"0 0 880 220\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"评价与复核闭环\"><rect width=\"880\" height=\"220\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"25\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"40\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">共享测试点</text><path d=\"M184 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"30\" y=\"166\" font-size=\"16\" fill=\"#223e46\">192点</text><rect x=\"198\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"213\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">模型 / 阈值</text><path d=\"M357 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"203\" y=\"166\" font-size=\"16\" fill=\"#223e46\">相同输入</text><rect x=\"371\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"386\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">独立真值</text><path d=\"M530 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"376\" y=\"166\" font-size=\"16\" fill=\"#223e46\">仅评价使用</text><rect x=\"544\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">误差深度图</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">选中定位</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">人工与导出</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">保留原预测</text></g></svg><figcaption>输入：模型/阈值预测；独立评价真值仅用于计分；动作：在同一 192 点上计算带拒判列的混淆矩阵；保留人工意见；产物：宏 F1、每类召回、覆盖率、接受集错误率、当前证据 JSON。拒判保留在总分母；人工意见单独保存，不修改模型原始成绩。</figcaption></figure>"
      }
    },
    "demo": {
      "mode": "page",
      "html": "demo/index.html",
      "js": "demo/demo.js",
      "label": "可运行示范",
      "height": 1250,
      "intro": "观察套管波幅与后到波列，比较单声幅阈值和多特征近邻；亲手加入微环空、偏心或噪声，查看哪些深度需要补充证据。"
    }
  }
}
