l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>把循环流动、排量和泵压联系起来，先说明压力变化的来源。</p><p>地面泵把钻井液送入钻柱，经钻头喷嘴进入环空再返回地面。立管压力是这条循环路径阻力的综合响应。流量增大本来就会提高压力，因此一次泵压上升不能直接等同于井下故障。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"正常泵压与流量\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">立管压力 P / MPa</text><path d=\"M85.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">20</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">8</text><path d=\"M243.75 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"243.75\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">22.5</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">9</text><path d=\"M402.5 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.5\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">25</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">10</text><path d=\"M561.25 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"561.25\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">27.5</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">11</text><path d=\"M720.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">30</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">12</text><path d=\"M85.00,203.00L212.00,186.35L339.00,169.70L466.00,153.05L593.00,136.40L720.00,119.75\" stroke=\"#14796f\" stroke-width=\"3\" fill=\"none\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#14796f\">RPM固定100 r/min</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">流量 Q / L·s⁻¹</text></svg><figcaption>图B1｜流量本来就会抬高正常泵压。手算教学例固定RPM=100 r/min，P=4+0.18Q+0.012RPM；Q从20升至30 L/s，正常泵压从8.8升至10.6 MPa。此上升本身不能确诊故障。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "PRINCIPLE",
          "title": "把工况变化与异常分开",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>比较实测压力与正常关系预测，残差是二者之差。</p><p>先用正常时段学习压力和流量、转速的统计关系，再计算残差：实测压力减去正常预测。流量增加但残差不大时，说明变化仍可由正常工况解释；持续正残差才形成复核线索。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"残差与5窗平均\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">残差 / MPa</text><path d=\"M85.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">0</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">0</text><path d=\"M243.75 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"243.75\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">3</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">0.3</text><path d=\"M402.5 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.5\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">6</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">0.6</text><path d=\"M561.25 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"561.25\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">9</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">0.9</text><path d=\"M720.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">12</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1.2</text><path d=\"M85.00,240.00L137.92,224.58L190.83,240.00L243.75,101.25L296.67,240.00L349.58,240.00L402.50,209.17L455.42,178.33L508.33,147.50L561.25,116.67L614.17,85.83L667.08,55.00\" stroke=\"#929ca3\" stroke-width=\"3\" fill=\"none\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#929ca3\">单窗残差</text><path d=\"M85.00,240.00L137.92,232.29L190.83,234.86L243.75,201.46L296.67,209.17L349.58,209.17L402.50,206.08L455.42,193.75L508.33,203.00L561.25,178.33L614.17,147.50L667.08,116.67\" stroke=\"#14796f\" stroke-width=\"3\" fill=\"none\"/><text x=\"305\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#14796f\">仅用当前与过去5窗</text><path d=\"M85.00,170.62L667.08,170.62\" stroke=\"#c07648\" stroke-width=\"3\" fill=\"none\"/><text x=\"515\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#c07648\">阈值0.45 MPa</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">时间 / min</text></svg><figcaption>图B2｜同一压力先作差，再平滑。孤立尖峰被平均压低；持续附加阻力让均值逐渐越阈。本例只是压力偏离线索，未区分堵塞、流变改变等成因。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "INTERPRETATION",
          "title": "预警提前量必须有参照时点",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>把报警放回时间轴，对照事件起点和误报时段。</p><p>本例把145分钟设为教学事件时点，125分钟起加入渐变。提前量等于事件时点减去首个有效告警时点。正常段误报与先兆段应分别统计，不能把所有非事件窗混在一个分母中。</p><p>图中阴影表示注入区，指标同时报告正常段告警窗和事件是否被发现。</p><p class=\"sub\">专业资料：<a href=\"https://www.apps.slb.com/cmd/ChannelItem.aspx?code=SPPA\" target=\"_blank\" rel=\"noopener\">SLB｜Standpipe pressure 曲线字典</a>。本例采用固定种子教学数据；数据结构、单位与评价范围在演示中列出。</p><aside class=\"learning-task\"><h3>先做一个可核对实验</h3><p>把异常附加泵压设为0，重新计算，记录正常段告警；再设为1.4 MPa，对照145 min竖虚线与125—164 min阴影，说明残差阈值变大为何可能使提前量减少。固定泵压阈值单独改变，应只改变基线判断，不改变学习的正常压力。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>泵压随正常工况变化；先预测正常响应，再看持续偏离，能帮助区分负荷变化与异常。</h2><p>从一段泵压监测记录出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>为什么泵压会变化</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>把工况变化与异常分开</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>预警提前量必须有参照时点</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "泵压升高究竟是流量调整，还是异常逐渐形成？",
      "lead": [
        "泵压升高究竟是流量调整，还是异常逐渐形成？",
        "按下列手算例理解运算，再进入示范改变同一数据上的模型和基线。"
      ],
      "stats": [
        [
          "步骤",
          "3"
        ],
        [
          "运行",
          "离线"
        ]
      ],
      "steps": [
        {
          "name": "学习正常关系",
          "role": "步骤1",
          "do": "用120个正常窗拟合P=f(Q,RPM)。",
          "effect": "冻结回归系数",
          "trap": "异常时段不参与训练。"
        },
        {
          "name": "计算未来残差",
          "role": "步骤2",
          "do": "对210个未来窗预测正常泵压，计算5窗均值。",
          "effect": "残差时间曲线",
          "trap": "瞬时尖峰与持续偏离分开。"
        },
        {
