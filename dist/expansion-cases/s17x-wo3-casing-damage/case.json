16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"86\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"103\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"120\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"137\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"154\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"171\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"188\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"205\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"222\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"239\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"256\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"273\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"290\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"307\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"324\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"341\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"358\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"375\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"392\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"409\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"426\" y=\"142\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"35\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"52\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"69\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"86\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"103\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"120\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"137\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"154\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"171\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"188\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"205\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"222\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"239\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"256\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"273\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"290\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"307\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"324\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"341\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"358\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"375\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"392\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"409\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><rect x=\"426\" y=\"156\" width=\"16\" height=\"13\" fill=\"#bed7d2\"/><text x=\"480\" y=\"65\">圆周切开 → 方位展开</text><text x=\"480\" y=\"110\">横轴：0–360°</text><text x=\"480\" y=\"150\">纵轴：深度向下</text></g></svg><figcaption>局部凹坑只覆盖少数深度与方位，展开后呈局部色块。</figcaption></figure>"
        },
        {
          "no": 2,
          "en": "METHOD",
          "title": "先认识偏心，再定位局部异常",
          "html": "<p>偏心使半径随方位角近似呈一次谐波起伏。算法以每一方位跨深度的中位数拟合该背景，然后扣除，避免把整条方位带当作腐蚀。局部异常在扣除背景后仍形成连片正残差。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"先认识偏心，再定位局部异常\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><polyline points=\"35,150 90,115 145,90 200,105 255,145 310,170 365,155\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><polyline points=\"35,110 90,110 145,110 200,65 255,60 310,110 365,110\" fill=\"none\" stroke=\"#b77e4e\" stroke-width=\"3\"/><text x=\"400\" y=\"80\">青：平滑偏心背景</text><text x=\"400\" y=\"120\">棕：扣除后局部异常</text><text x=\"400\" y=\"160\">残差 = 实测 − 方位中位数</text></g></svg><figcaption>偏心背景平滑跨越整圈；扣除背景后才突出局部异常。</figcaption></figure>"
        },
        {
          "no": 3,
          "en": "EVIDENCE",
          "title": "面积重叠评价定位",
          "html": "<p>教学数据含一个已知位置的局部缺陷。预测只看半径矩阵，评价阶段再读取隐藏掩膜计算IoU：交集格数除以并集格数。缺陷幅度设为0时是真正的无缺陷样本，IoU在双方都为空时记1，并报告误报格数。</p><p>默认数据为固定种子的教学构造数据，所有计算在浏览器本地执行。结果随当前参数生成，可导出JSON查看。</p><p>专业概念参考：<a href=\"https://www.osha.gov/etools/oil-and-gas/glossary-of-terms-c\" target=\"_blank\" rel=\"noopener\">专业机构原始资料</a>。教学数据与上述专业概念来源分开记录。</p>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "展开图上的大半径，一定是套管损伤吗？",
      "lead": [
        "多指井径仪沿深度记录不同方位的内壁半径。仪器偏心会让整圈出现平滑起伏，局部内壁凹坑则只占较小的深度和方位范围。"
      ],
      "steps": [
        {
          "name": "采集深度×方位矩阵",
          "role": "步骤 1",
          "do": "按36个相对深度位置和36个方位采样半径偏差。界面生成平滑偏心项、局部凹坑和测量噪声，三者叠加成算法看到的矩阵。",
          "effect": "1296格半径偏差矩阵",
          "trap": "颜色数值表示mm，不是损伤类别"
        },
        {
          "name": "估计偏心背景",
          "role": "步骤 2",
          "do": "对每个方位收集36个深度值，取中位数作为该方位的平滑背景。该方法利用本例缺陷只占少量深度的条件，不读取缺陷位置。",
          "effect": "36个方位背景值",
          "trap": "大范围损伤占据多数深度时，中位数背景也会受影响"
        },
        {
          "name": "残差阈值分割缺陷",
          "role": "步骤 3",
          "do": "将半径矩阵减去方位背景，残差超过当前阈值的格子形成预测掩膜。点击右图格子读出深度、方位和残差；细描边标识模型预测。",
          "effect": "去背景热图和预测缺陷格子",
          "trap": "阈值过低放大噪声；过高会遗漏浅缺陷"
        },
        {
          "name": "与原始阈值对照",
          "role": "步骤 4",
          "do": "另一路直接对原始半径使用同阈值，作为基线。最后仅在评价函数读取参考掩膜，计算两路IoU及预测误报格数。",
          "effect": "IoU、误报格数与并排热图",
          "trap": "缺陷幅度为0时评价无缺陷情况，不除以0"
        }
      ],
