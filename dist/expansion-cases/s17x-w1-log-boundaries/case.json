t [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>曲线中的变化是地层边界，还是一个测量尖峰？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"w1\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"测井曲线智能分层：识别持续改变的地层响应\"><defs><marker id=\"cf-w1\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-w1)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">GR与电阻率</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">0.5m深度对齐曲线</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">两侧滑窗特征</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">比较均值的持续改变</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">学习边界分数</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">6训练井逻辑回归</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">GR单点梯度</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">局部尖峰阈值对照</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">输入与场景是否对应？差异需要人工复核吗？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">一对一边界核对</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">一对一匹配与重复误报</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">分层位置与误差</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">边界F1与深度MAE</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">间距约束合并</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">保留最小边界间距</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 构建两侧特征</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 识别并合并边界</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 一对一核对边界</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 3</span><h3>构建两侧特征</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>6口训练井提取GR和logRt两侧均值差。</p></div><div class=\"table-scroll\"><table><caption>两侧均值差特征的手算例（手算教学例）</caption><thead><tr><th>通道</th><th>上窗均值</th><th>下窗均值</th><th>差值</th></tr></thead><tbody><tr><td>GR / API</td><td>35</td><td>105</td><td>70</td></tr><tr><td>log₁₀(Rt/1 Ω·m)</td><td>1.6</td><td>0.5</td><td>1.1</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>1020个候选训练位置</p></div><div><b>理解这一步</b><p>训练、测试按完整井段划分。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 3</span><h3>识别并合并边界</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>逻辑回归评分，再做最小间距抑制。</p></div><div class=\"table-scroll\"><table><caption>相近候选只保留一个（手算教学例）</caption><thead><tr><th>候选MD / m</th><th>未校准支持分数</th><th>最小间距2m时</th></tr></thead><tbody><tr><td>1220</td><td>0.8</td><td>保留</td></tr><tr><td>1220.5</td><td>0.7</td><td>抑制</td></tr><tr><td>1228</td><td>0.6</td><td>保留</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>候选分数与最终边界</p></div><div><b>理解这一步</b><p>阈值更新后，查看当前分数与候选边界。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 3</span><h3>一对一核对边界</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>以±1.5m容差匹配3个测试真边界。</p></div><div class=\"table-scroll\"><table><caption>一对一容差匹配（手算教学例）</caption><thead><tr><th>预测MD / m</th><th>真边界MD / m</th><th>结论</th></tr></thead><tbody><tr><td>1220</td><td>1220.5</td><td>误差0.5m，命中</td></tr><tr><td>1221</td><td>1220.5</td><td>同一真边界已用，重复误报</td></tr><tr><td>无预测</td><td>1240</td><td>漏报</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>边界F1与匹配深度误差</p></div><div><b>理解这一步</b><p>按一对一匹配统计误报、漏报与深度误差。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
      },
      "lessonHTML": "<div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>曲线中的变化是地层边界，还是一个测量尖峰？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"w1\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"测井曲线智能分层：识别持续改变的地层响应\"><defs><marker id=\"cf-w1\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-w1)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-w1)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">GR与电阻率</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">0.5m深度对齐曲线</text></g><g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">两侧滑窗特征</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">比较均值的持续改变</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">学习边界分数</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">6训练井逻辑回归</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">GR单点梯度</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">局部尖峰阈值对照</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">输入与场景是否对应？差异需要人工复核吗？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">一对一边界核对</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">一对一匹配与重复误报</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">分层位置与误差</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">边界F1与深度MAE</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">间距约束合并</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">保留最小边界间距</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 构建两侧特征</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 识别并合并边界</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 一对一核对边界</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 3</span><h3>构建两侧特征</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>6口训练井提取GR和logRt两侧均值差。</p></div><div class=\"table-scroll\"><table><caption>两侧均值差特征的手算例（手算教学例）</caption><thead><tr><th>通道</th><th>上窗均值</th><th>下窗均值</th><th>差值</th></tr></thead><tbody><tr><td>GR / API</td><td>35</td><td>105</td><td>70</td></tr><tr><td>log₁₀(Rt/1 Ω·m)</td><td>1.6</td><td>0.5</td><td>1.1</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>1020个候选训练位置</p></div><div><b>理解这一步</b><p>训练、测试按完整井段划分。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 3</span><h3>识别并合并边界</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>逻辑回归评分，再做最小间距抑制。</p></div><div class=\"table-scroll\"><table><caption>相近候选只保留一个（手算教学例）</caption><thead><tr><th>候选MD / m</th><th>未校准支持分数</th><th>最小间距2m时</th></tr></thead><tbody><tr><td>1220</td><td>0.8</td><td>保留</td></tr><tr><td>1220.5</td><td>0.7</td><td>抑制</td></tr><tr><td>1228</td><td>0.6</td><td>保留</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>候选分数与最终边界</p></div><div><b>理解这一步</b><p>阈值更新后，查看当前分数与候选边界。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 3</span><h3>一对一核对边界</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>以±1.5m容差匹配3个测试真边界。</p></div><div class=\"table-scroll\"><table><caption>一对一容差匹配（手算教学例）</caption><thead><tr><th>预测MD / m</th><th>真边界MD / m</th><th>结论</th></tr></thead><tbody><tr><td>1220</td><td>1220.5</td><td>误差0.5m，命中</td></tr><tr><td>1221</td><td>1220.5</td><td>同一真边界已用，重复误报</td></tr><tr><td>无预测</td><td>1240</td><td>漏报</td></tr></tbody></table></div><div class=\"xl-products\"><div><b>得到什么</b><p>边界F1与匹配深度误差</p></div><div><b>理解这一步</b><p>按一对一匹配统计误报、漏报与深度误差。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
