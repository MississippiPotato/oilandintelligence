l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>在共同深度轴读GR等测井响应，深度向下增加。</p><p>自然伽马GR反映地层天然放射性，常用于提示泥质变化；电阻率Rt反映电流通过地层的难易，受流体、孔隙和岩性等共同影响。不同地层可能形成不同的曲线组合。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"GR深度记录\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">MD / m ↓</text><path d=\"M85.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">0</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1200</text><path d=\"M243.75 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"243.75\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">35</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1204</text><path d=\"M402.5 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.5\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">70</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1208</text><path d=\"M561.25 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"561.25\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">105</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1212</text><path d=\"M720.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">140</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1216</text><path d=\"M230.14,55.00L243.75,101.25L234.68,147.50L561.25,153.28L552.18,193.75L565.79,240.00\" stroke=\"#14796f\" stroke-width=\"3\" fill=\"none\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#14796f\">GR</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">GR / API</text></svg><figcaption>图B1｜两道曲线共同识别持续变化。纵轴是测深MD，向下增加；边界附近GR由低值持续转为高值，与单点尖峰形成对照。实际演示另列Rt深度道，单位不混用。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "PRINCIPLE",
          "title": "边界是两侧一段数据的改变",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>比较界面两侧窗口，区分局部噪点与连续响应改变。</p><p>单点梯度容易把尖峰误判为边界。滑窗方法比较候选深度两侧的平均GR与对数Rt，使持续改变得到更高支持；预测边界最小间距避免在同一变化附近反复插入边界。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"边界两侧数据窗\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">MD / m ↓</text><path d=\"M85.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">0</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1206</text><path d=\"M243.75 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"243.75\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">35</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1206.75</text><path d=\"M402.5 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.5\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">70</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1207.5</text><path d=\"M561.25 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"561.25\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">105</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1208.25</text><path d=\"M720.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">140</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1209</text><circle cx=\"221.07142857142856\" cy=\"55.0\" r=\"4\" fill=\"#547da0\"/><circle cx=\"243.75\" cy=\"85.83333333333333\" r=\"4\" fill=\"#547da0\"/><circle cx=\"266.42857142857144\" cy=\"116.66666666666666\" r=\"4\" fill=\"#547da0\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#547da0\">上窗：均值35 API</text><circle cx=\"538.5714285714286\" cy=\"147.5\" r=\"4\" fill=\"#c07648\"/><circle cx=\"561.25\" cy=\"178.33333333333331\" r=\"4\" fill=\"#c07648\"/><circle cx=\"583.9285714285714\" cy=\"209.16666666666669\" r=\"4\" fill=\"#c07648\"/><text x=\"305\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#c07648\">下窗：均值105 API</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">GR / API</text></svg><figcaption>图B2｜边界候选比较上下两侧窗口。手算例上、下窗GR均值相差70 API；同样对logRt求差。逻辑回归组合这些可见变化，最小边界间距只控制预测去重，同时观察相邻候选如何被合并或保留。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "INTERPRETATION",
          "title": "边界评价要一对一匹配",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>将候选界面与参考一对一匹配，避免重复命中。</p><p>预测边界允许在真边界附近1.5m内匹配，但一个真边界只能被匹配一次。重复预测仍算误报；漏掉的边界记为漏报。F1与已匹配边界的深度误差一起报告。</p><p>橙色为预测位置，灰色为独立教学真边界，图上可逐处对照。</p><p class=\"sub\">专业资料：<a href=\"https://glossary.slb.com/terms/g/gamma_ray_log\" target=\"_blank\" rel=\"noopener\">SLB｜Gamma ray log</a>；<a href=\"https://www.slb.com/-/media/files/oilfield-review/defining-log-interpretation.ashx\" target=\"_blank\" rel=\"noopener\">SLB｜Basic well log interpretation</a>。本例采用固定种子教学数据；数据结构、单位与评价范围在演示中列出。</p><aside class=\"learning-task\"><h3>先做一个可核对实验</h3><p>把噪声从1调到3重算，同时看GR、Rt与模型分数三个深度道；将每侧窗口从2调到12，观察峰的展宽及最终边界。再把学习阈值降到0.05后增大最小边界间距，观察噪声近邻候选被抑制；默认三条真边界距离较远，间距控件可能不改变输出。本页三条边界间距较大，重点比较噪声、窗口宽度与候选去重。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>分层寻找一段曲线关系的持续改变；单点尖峰和真正界面要用邻域比较。</h2><p>从一个候选层界面出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>测井曲线沿深度记录响应</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>边界是两侧一段数据的改变</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>边界评价要一对一匹配</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "曲线中的变化是地层边界，还是一个测量尖峰？",
      "lead": [
        "曲线中的变化是地层边界，还是一个测量尖峰？",
        "按下列手算例理解运算，再进入示范改变同一数据上的模型和基线。"
      ],
      "stats": [
        [
          "步骤",
          "3"
        ],
        [
          "运行",
          "离线"
        ]
      ],
      "steps": [
        {
          "name": "构建两侧特征",
          "role": "步骤1",
          "do": "6口训练井提取GR和logRt两侧均值差。",
          "effect": "1020个候选训练位置",
          "trap": "训练、测试按完整井段划分。"
        },
        {
          "name": "识别并合并边界",
          "role": "步骤2",
          "do": "逻辑回归评分，再做最小间距抑制。",
          "effect": "候选分数与最终边界",
          "trap": "阈值更新后，查看当前分数与候选边界。"
        },
        {
          "name": "一对一核对边界",
          "role": "步骤3",
