l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>沿时间顺序区分三个阶段，各阶段的作用不同。</p><p>注汽阶段向井中送入蒸汽；焖井阶段暂时关闭井口；生产阶段再开井产出。三段的时间加总才是一个周期。界面以时间带对齐阶段，以候选散点比较固定90天生产窗的累计产油折算目标；本例没有逐日产油曲线。蒸汽加热可降低稠油黏度，焖井促进热量传递，随后同井开采；这里的初温只是代理输入，没有模拟热传导或蒸汽品质。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"三个阶段不能混成连续注采\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><rect x=\"25\" y=\"45\" width=\"180\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"37\" y=\"73\">注汽：送入热量</text><rect x=\"265\" y=\"45\" width=\"180\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"277\" y=\"73\">焖井：热量交换</text><rect x=\"505\" y=\"45\" width=\"180\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"517\" y=\"73\">生产：回收流体</text><polyline points=\"207,67 263,67\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><polyline points=\"447,67 503,67\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><text x=\"45\" y=\"145\">同一口井，阶段先后发生</text><text x=\"45\" y=\"185\">比较候选时统一生产窗口：90天</text></g></svg><figcaption>同一口井依次注汽、焖井和生产；比较前必须统一生产统计窗口。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "METHOD",
          "title": "产油和热投入用同一边界比较",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>把采油量与热投入放在同一周期边界比较。</p><p>输入蒸汽量t、焖井天数d和初温°C，代理输出固定90天生产窗的产油量t。目标J=预测产油−成本折算系数×蒸汽量，单位是折算油吨。改变成本系数后，最佳点可能从高注汽量移向较低用量。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"产油和热投入用同一边界比较\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><rect x=\"30\" y=\"35\" width=\"190\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"42\" y=\"63\">预测产油 t</text><rect x=\"265\" y=\"35\" width=\"190\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"277\" y=\"63\">蒸汽量 × 折算系数</text><rect x=\"500\" y=\"35\" width=\"190\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"512\" y=\"63\">净目标 J（t油）</text><text x=\"235\" y=\"65\">−</text><text x=\"470\" y=\"65\">=</text><text x=\"50\" y=\"140\">预算变化会改变可行区；价格变化会改变排序</text><text x=\"50\" y=\"180\">同时看汽油比，避免只追逐累计产油</text></g></svg><figcaption>折算目标从预测产油扣除蒸汽投入，性能最高与投入最合算并非同一件事。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "EVIDENCE",
          "title": "候选搜索并不读取产油真值",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>先固定预测关系，再在蒸汽上限和费用下搜索候选。</p><p>120条教学周期训练回归，40条完整留出周期评价MAE。网格候选只调用冻结回归，蒸汽上限逐点过滤。固定1200t、焖井4天为对照。最终同时展示目标值、汽油比和周期时间，不把代理增益写成现场增油。</p><p>默认数据为固定种子的教学构造数据，所有计算在浏览器本地执行。结果随当前参数生成，可导出JSON查看。</p><p>专业概念参考：<a href=\"https://glossary.slb.com/en/terms/c/cyclic_steam_stimulation\" target=\"_blank\" rel=\"noopener\">专业机构原始资料</a>。教学数据与上述专业概念来源分开记录。</p></div>"
        },
        {
          "no": 4,
          "en": "LEARNING_TASK",
          "title": "课堂实验：一次只改变一个条件",
          "html": "<div class=\"xl-knowledge\"><aside class=\"learning-task\"><h3>动手前先提出判断</h3><p>保持初温45°C、蒸汽上限1500t，将成本系数0.02改为0.12，记录最佳蒸汽量、焖井天数与J的变化。读取周期各边界天数，核算总周期=蒸汽量/200+焖井+90。再把上限改600t：固定1200t方案必须显示不可行，目标改善为不适用；各候选仍统一比较90天生产量。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>蒸汽吞吐把注汽、焖井和采油分成阶段；比较效果需要采用相同的热量与时间边界。</h2><p>从一个吞吐周期方案出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>三个阶段不能混成连续注采</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>产油和热投入用同一边界比较</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>候选搜索并不读取产油真值</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "注汽更久，新增产油是否足以补偿热量投入？",
      "lead": [
        "蒸汽吞吐在同一口井交替经历注汽、焖井和生产。注汽带入热量，焖井促进热交换，生产阶段回收流体；本例比较周期内的预测产油与蒸汽投入。"
      ],
      "steps": [
        {
          "name": "对齐注汽焖井生产",
          "role": "步骤 1",
          "do": "统一90天生产窗口，分别记录蒸汽量、焖井天数和初温。注汽天数按200t/d教学速率计算，不能把不同长度生产窗混在一起。",
          "effect": "时间边界一致的完整周期记录",
          "trap": "焖井阶段没有生产量，不与生产阶段重叠"
        },
        {
          "name": "拟合周期产油代理",
          "role": "步骤 2",
          "do": "从120个训练周期学习二次产油响应，40个独立周期计算留出MAE；训练均值给出不看条件的对照误差。",
          "effect": "冻结的周期产油代理",
          "trap": "候选预测不调用生成式或测试标签"
        },
        {
          "name": "约束蒸汽量搜索参数",
          "role": "步骤 3",
          "do": "枚举17档蒸汽量×8档焖井时间共136点，逐点检查蒸汽上限。可行点目标为预测产油减去蒸汽量乘成本折算系数。",
          "effect": "满足资源上限的候选和J值",
          "trap": "目标单位是折算油吨，不是货币利润"
        },
        {
          "name": "核对收益与热量账",
          "role": "步骤 4",
          "do": "展示最佳点的注汽、焖井、生产时间带，以及全部候选目标散点和汽油比；固定1200t、焖井4天按同一代理比较。",
          "effect": "周期图、资源收益与真实预测差值",
          "trap": "若固定方案已经最佳，目标改善如实为0"
        }
      ],
      "metrics": {
        "title": "步骤的输入与产物",
        "html": "<style>/* Applied only to the56 expansion lessons; data-category colors are preserved. */\n.xl-lesson,.xl-parent{--xl-red:#b8242a;--xl-paper:#f7f4ef;--xl-ink:#292d34;--xl-muted:#66717d;--xl-line:#e6dfd7;color:var(--xl-ink);font-size:18px;line-height:1.85}\nbody.xl-lesson{margin:0;background:var(--xl-paper);font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}\n.xl-lesson>header{max-width:1180px;margin:28px auto 0;padding:32px 38px 20px;background:#fff;border:1px solid var(--xl-line);border-radius:24px;box-shadow:0 8px 30px #3b282608}\n.xl-lesson>header h1{color:#292d34;font-size:clamp(25px,2.6vw,36px);line-height:1.5;max-width:1000px;margin:12px 0}\n.xl-lesson>main{max-width:1180px;margin:24px auto 70px;padding:0 0 25px;min-width:0}\n.xl-lesson>header nav{position:static;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;padding:14px 0 0;margin:14px 0 0}\n.xl-lesson>nav{max-width:1180px;margin:18px auto;padding:0 10px;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;position:static}\n.xl-lesson>nav button[aria-selected=\"true\"]{background:var(--xl-red);border-color:var(--xl-red);color:white}\n.xl-lesson>header nav button,.xl-lesson button,.xl-parent button{font:inherit;line-height:1.5;min-height:44px;cursor:pointer}\n.xl-lesson button,.xl-parent .xl-step-nav button,.xl-parent .xl-next button{background:#fff;color:#4d4343;border:1px solid #ddd5d0;border-radius:13px;padding:10px 17px;transition:background .15s,border-color .15s,box-shadow .15s}\n.xl-lesson button:hover,.xl-parent .xl-step-nav button:hover{border-color:var(--xl-red);background:#fff8f5}\n.xl-lesson button.primary,.xl-lesson button.active,.xl-lesson header nav button[aria-pressed=\"true\"],.xl-lesson header nav button[aria-selected=\"true\"],.xl-step-nav button[aria-selected=\"true\"],.xl-parent .xl-next button{background:var(--xl-red);color:white;border-color:var(--xl-red)}\n.xl-lesson button:disabled{opacity:.45;cursor:default}\n.xl-lesson :focus-visible,.xl-parent :focus-visible{outline:3px solid #b8242a88;outline-offset:4px}\n.xl-lesson input,.xl-lesson select,.xl-lesson textarea{font:inherit;min-width:0;max-width:100%;accent-color:var(--xl-red);border-radius:9px}\n.xl-lesson input[type=range]{width:100%}.xl-lesson label{font-size:17px;color:#45434a}\n.xl-lesson p{max-width:100%;overflow-wrap:anywhere}\n.xl-lesson .intro,.xl-lesson .note,.xl-lesson .small,.xl-lesson .data-note,.xl-lesson .legend,.xl-lesson figcaption,.xl-parent figcaption,.xl-parent .note{font-size:16px;line-height:1.8;color:#64707a}\n.xl-lesson .source-badge,.xl-kicker{font-size:13px;letter-spacing:.1em;color:var(--xl-red);font-weight:700;text-transform:uppercase}\n.xl-lesson .brand,.xl-lesson .eyebrow,.xl-lesson .tag,.xl-lesson .kicker,.xl-lesson output,.xl-lesson>header a{color:var(--xl-red)}\n.xl-parent #tabs .tab.on{background:var(--xl-red);border-color:var(--xl-red);color:#fff}\n.xl-lesson h2,.xl-parent .xl-opening h2{font-size:25px;line-height:1.55;color:#292d34;margin:12px 0 20px}\n.xl-lesson h3{font-size:21px;color:#333842;line-height:1.55}\n.xl-lesson .card,.xl-lesson .panel,.xl-lesson .reading-block,.xl-lesson .plot-grid>article,.xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide{background:#fff;border:1px solid var(--xl-line);border-radius:20px;box-shadow:0 5px 22px #382b2105;padding:26px 30px;margin:20px 0}\n.xl-opening{padding:28px 32px;background:linear-gradient(120deg,#fff 60%,#fff3ed)}\n.xl-opening h2{max-width:960px;font-size:27px;font-weight:650;line-height:1.65}\n.xl-opening>p{margin-bottom:0;color:var(--xl-muted)}\n.xl-reading-path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0 2px}\n.xl-reading-path a{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;background:#fff;border:1px solid #ece3dd;border-radius:14px;color:#4d4343;text-decoration:none;line-height:1.6;font-size:16px}\n.xl-reading-path a span{font-size:13px;color:var(--xl-red);font-weight:750}\n.xl-read{padding:13px 17px;border-left:3px solid var(--xl-red);background:#fbf6f1;color:#5d4f49;font-size:16px;line-height:1.8;border-radius:0 10px 10px 0}\n.xl-read b{display:block;color:var(--xl-red);font-size:13px;letter-spacing:.05em;margin-bottom:4px}\n.xl-chapter{scroll-margin-top:22px}\n.xl-knowledge>p{margin:20px 0}.xl-knowledge>p.xl-read{margin:0 0 22px}\n.xl-knowledge figure{margin:24px 0}.xl-knowledge svg,.xl-method-step svg{display:block;width:100%;max-width:900px;max-height:280px;height:auto;margin:18px auto}\n.xl-knowledge img{max-width:100%;height:auto;border-radius:12px}\n.xl-diagram,.xl-data-plot{max-width:100%;min-width:0;overflow:auto}.xl-diagram-hint{display:none}\n.xl-method>.case-flow-overview,.xl-parent .case-flow-overview{margin:20px 0;background:#fff;border:1px solid var(--xl-line);border-radius:20px;padding:20px;box-shadow:none}\n.xl-method .case-flow-overview svg{max-height:300px;width:100%;height:auto}\n.xl-step-nav{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 14px}\n.xl-step-nav button{font-size:16px;border-radius:12px;padding:10px 13px}\n.xl-step-heading{display:flex;align-items:center;gap:18px;margin-bottom:18px}.xl-step-heading h3{margin:0;font-size:24px}\n.xl-action-copy>b,.xl-products b{font-size:14px;color:var(--xl-red)}.xl-action-copy p{margin:7px 0 24px}\n.xl-products{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--xl-line);padding-top:18px;margin-top:22px}\n.xl-products p{font-size:17px;margin:7px 0}.xl-next{display:flex;justify-content:flex-end;margin:22px 0}\n.xl-lab-guide{border-top:3px solid var(--xl-red);padding:22px 28px}\n.xl-lab-guide h2{margin:4px 0 10px;font-size:23px}.xl-lab-guide>p{margin:8px 0 16px;color:#645f61;font-size:17px}\n.xl-task-actions{display:flex;gap:10px;flex-wrap:wrap}.xl-task-actions button{font-size:16px}\n.xl-task-actions button[aria-pressed=\"true\"]{background:#fbebeb;border-color:#c27b7e;color:#9c2026}\n.xl-task-look{padding-top:14px;border-top:1px solid var(--xl-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>注汽更久，新增产油是否足以补偿热量投入？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"e4\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"蒸汽吞吐周期搜索\"><defs><marker id=\"cf-e4\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-e4)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e4)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">蒸汽量及初温</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">同井注焖采三阶段</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">完整周期拆分</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">统一九十天生产窗</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">产油回归代理</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">只用可见周期参数</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">固定蒸汽方案</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">一千二百吨焖四天</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">蒸汽资源限制满足？调整成本再搜索</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">逐点检查蒸汽限</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">折算成本后比较目标</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">周期边界与轨迹</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">产油汽油比及总天数</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">留出周期评价</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">代理改善非现场增油</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 对齐注汽焖井生产</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 拟合周期产油代理</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 约束蒸汽量搜索参数</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-3\" data-xl-step=\"3\">04 核对收益与热量账</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 4</span><h3>对齐注汽焖井生产</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>统一90天生产窗口，分别记录蒸汽量、焖井天数和初温。注汽天数按200t/d教学速率计算，不能把不同长度生产窗混在一起。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F1：对齐注汽焖井生产的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 1｜对齐注汽焖井生产</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：统一90天生产窗口，分别记录蒸汽量、焖井天数和初温。注汽天数按200</text><text x=\"42\" y=\"113\" font-size=\"16\">t/d教学速率计算，不能把不同长度生产窗混在一起。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：时间边界一致的完整周期记录</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：焖井阶段没有生产量，不与生产阶段重叠</text></g></svg><figcaption>图 F1：对齐注汽焖井生产的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>时间边界一致的完整周期记录</p></div><div><b>理解这一步</b><p>焖井阶段没有生产量，不与生产阶段重叠</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 4</span><h3>拟合周期产油代理</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>从120个训练周期学习二次产油响应，40个独立周期计算留出MAE；训练均值给出不看条件的对照误差。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F2：拟合周期产油代理的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 2｜拟合周期产油代理</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：从120个训练周期学习二次产油响应，40个独立周期计算留出MAE；训</text><text x=\"42\" y=\"113\" font-size=\"16\">练均值给出不看条件的对照误差。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：冻结的周期产油代理</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：候选预测不调用生成式或测试标签</text></g></svg><figcaption>图 F2：拟合周期产油代理的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>冻结的周期产油代理</p></div><div><b>理解这一步</b><p>候选预测不调用生成式或测试标签</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 4</span><h3>约束蒸汽量搜索参数</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>枚举17档蒸汽量×8档焖井时间共136点，逐点检查蒸汽上限。可行点目标为预测产油减去蒸汽量乘成本折算系数。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F3：约束蒸汽量搜索参数的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 3｜约束蒸汽量搜索参数</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：枚举17档蒸汽量×8档焖井时间共136点，逐点检查蒸汽上限。可行点目</text><text x=\"42\" y=\"113\" font-size=\"16\">标为预测产油减去蒸汽量乘成本折算系数。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：满足资源上限的候选和J值</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：目标单位是折算油吨，不是货币利润</text></g></svg><figcaption>图 F3：约束蒸汽量搜索参数的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>满足资源上限的候选和J值</p></div><div><b>理解这一步</b><p>目标单位是折算油吨，不是货币利润</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-3\" data-xl-panel=\"3\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">04 / 4</span><h3>核对收益与热量账</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>展示最佳点的注汽、焖井、生产时间带，以及全部候选目标散点和汽油比；固定1200t、焖井4天按同一代理比较。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F4：核对收益与热量账的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 4｜核对收益与热量账</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：展示最佳点的注汽、焖井、生产时间带，以及全部候选目标散点和汽油比；固</text><text x=\"42\" y=\"113\" font-size=\"16\">定1200t、焖井4天按同一代理比较。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：周期图、资源收益与真实预测差值</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：若固定方案已经最佳，目标改善如实为0</text></g></svg><figcaption>图 F4：核对收益与热量账的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>周期图、资源收益与真实预测差值</p></div><div><b>理解这一步</b><p>若固定方案已经最佳，目标改善如实为0</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
      },
      "lessonHTML": "<div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>注汽更久，新增产油是否足以补偿热量投入？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"e4\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"蒸汽吞吐周期搜索\"><defs><marker id=\"cf-e4\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L