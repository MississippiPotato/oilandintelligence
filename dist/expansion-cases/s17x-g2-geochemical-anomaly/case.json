5H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-g2)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-g2)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">背景标定点</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">独立背景浓度</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">学习背景关系</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">均值与协方差</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">联合距离筛选</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">三组分偏离得分</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">C1标准分数</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">同点位单指标</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"3\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">资料与结果需要复核？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">核查采样来源</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">点选浓度与位置</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">异常候选点表</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">坐标与方法依据</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立参考评价</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">召回与误报分母</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><h3>建立独立背景</h3><p>输入：260个无目标异常背景点，保留C1–C3浓度。 动作：计算均值与协方差，甲烷背景波动与当前设置一致。</p><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"建立独立背景\"><rect width=\"760\" height=\"210\" rx=\"12\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#23453f\"><rect x=\"30\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#dceee6\"/><text x=\"42\" y=\"87\">260个无目标异常背</text><path d=\"M240 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"260\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#e2eaf4\"/><text x=\"272\" y=\"87\">计算均值与协方差，甲</text><path d=\"M470 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"490\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#f2e6cc\"/><text x=\"502\" y=\"87\">背景均值、协方差逆矩</text><text x=\"34\" y=\"168\">建立独立背景</text></g></svg><h3>计算联合距离</h3><p>输入：独立180个测试点，只向评分函数传浓度向量。 动作：按协方差归一化三组分的偏离，同时计算C1标准分数。</p><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"计算联合距离\"><rect width=\"760\" height=\"210\" rx=\"12\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#23453f\"><rect x=\"30\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#dceee6\"/><text x=\"42\" y=\"87\">独立180个测试点，</text><path d=\"M240 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"260\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#e2eaf4\"/><text x=\"272\" y=\"87\">按协方差归一化三组分</text><path d=\"M470 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"490\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#f2e6cc\"/><text x=\"502\" y=\"87\">每个点的联合距离和单</text><text x=\"34\" y=\"168\">计算联合距离</text></g></svg><h3>阈值筛选并定位</h3><p>输入：当前联合阈值和固定C1>2标准差基线。 动作：分别筛选候选，在同一地图叠加并允许点选。</p><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"阈值筛选并定位\"><rect width=\"760\" height=\"210\" rx=\"12\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#23453f\"><rect x=\"30\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#dceee6\"/><text x=\"42\" y=\"87\">当前联合阈值和固定C</text><path d=\"M240 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"260\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#e2eaf4\"/><text x=\"272\" y=\"87\">分别筛选候选，在同一</text><path d=\"M470 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"490\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#f2e6cc\"/><text x=\"502\" y=\"87\">候选点清单、原始组分</text><text x=\"34\" y=\"168\">阈值筛选并定位</text></g></svg><h3>独立参考核对</h3><p>输入：两种方法已固定的预测与教学参考。 动作：计算TP、FP、FN及F1、召回和误报率。</p><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"独立参考核对\"><rect width=\"760\" height=\"210\" rx=\"12\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#23453f\"><rect x=\"30\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#dceee6\"/><text x=\"42\" y=\"87\">两种方法已固定的预测</text><path d=\"M240 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"260\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#e2eaf4\"/><text x=\"272\" y=\"87\">计算TP、FP、FN</text><path d=\"M470 80h18l-5-4m5 4l-5 4\" stroke=\"#718c81\" fill=\"none\"/><rect x=\"490\" y=\"42\" width=\"208\" height=\"76\" rx=\"8\" fill=\"#f2e6cc\"/><text x=\"502\" y=\"87\">相同180点分母下的</text><text x=\"34\" y=\"168\">独立参考核对</text></g></svg>"
      }
