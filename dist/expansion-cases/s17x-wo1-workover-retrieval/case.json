2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"268\" y=\"90\" class=\"case-flow-edge\" text-anchor=\"middle\">原始观测</text><path d=\"M515 124H550\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"532\" y=\"90\" class=\"case-flow-edge\" text-anchor=\"middle\">特征</text><path d=\"M400 168V300H550\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"466\" y=\"285\" class=\"case-flow-edge\" text-anchor=\"middle\">同一输入</text><path d=\"M780 124H848V182\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"820\" y=\"102\" class=\"case-flow-edge\" text-anchor=\"middle\">候选</text><path d=\"M848 310V350\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"890\" y=\"333\" class=\"case-flow-edge\" text-anchor=\"middle\">待核查</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 80)\"><rect width=\"230\" height=\"88\" rx=\"25\" fill=\"#eaf1ee\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">井史与当前查询</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">作业描述 · 数值观测</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(285 80)\"><rect width=\"230\" height=\"88\" rx=\"12\" fill=\"#edf2f6\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">分井与联合特征</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">训练词表 + 数值尺度</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"model\" transform=\"translate(550 80)\"><rect width=\"230\" height=\"88\" rx=\"12\" fill=\"#dcefe7\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">联合相似度检索</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">文本分 + 观测分 → 历史近邻</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"baseline\" transform=\"translate(550 300)\"><rect width=\"230\" height=\"88\" rx=\"12\" fill=\"#f3eddf\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">关键词规则</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">固定词项命中的方案对照</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"4\"><polygon points=\"848,182 963,246 848,310 733,246\" fill=\"#fff2d7\"/><text x=\"848\" y=\"238\" text-anchor=\"middle\" class=\"case-flow-title\">显式施工</text><text x=\"848\" y=\"265\" text-anchor=\"middle\" class=\"case-flow-title\">条件满足？</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"4\" data-flow-node=\"review\" transform=\"translate(835 350)\"><rect width=\"230\" height=\"88\" rx=\"12\" fill=\"#f6e6db\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">核查拒选与来源</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">回看历史井与条件差异</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"output\" transform=\"translate(835 470)\"><rect width=\"230\" height=\"88\" rx=\"25\" fill=\"#dcefe7\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">修井方案候选</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">排序 · 邻井 ID · 拒选原因</text></g><g><rect x=\"20\" y=\"470\" width=\"230\" height=\"88\" rx=\"12\" fill=\"#eef0f0\" stroke=\"#bcc7c5\"/><text x=\"135\" y=\"503\" text-anchor=\"middle\" class=\"case-flow-title\">留出评价资料</text><text x=\"135\" y=\"532\" text-anchor=\"middle\" class=\"case-flow-detail\">仅在对照环节读取</text></g><g class=\"case-flow-node\" data-flow-step=\"5\" data-flow-node=\"compare\" transform=\"translate(550 470)\"><rect width=\"230\" height=\"88\" rx=\"12\" fill=\"#edf2f6\"/><text x=\"115\" y=\"33\" text-anchor=\"middle\" class=\"case-flow-title\">独立井组评价</text><text x=\"115\" y=\"62\" text-anchor=\"middle\" class=\"case-flow-detail\">命中、混淆矩阵与人工记录</text></g>\n <path d=\"M950 438V470\" fill=\"none\" stroke=\"#a6764b\" stroke-width=\"2.4\" stroke-dasharray=\"7 5\" marker-end=\"url(#cf-wo1)\"/><text x=\"1006\" y=\"458\" class=\"case-flow-edge\" text-anchor=\"middle\">确认后</text><path d=\"M963 246H1080V514H1065\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"1035\" y=\"231\" class=\"case-flow-edge\" text-anchor=\"middle\">可继续</text><path d=\"M250 514H550\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"397\" y=\"500\" class=\"case-flow-edge\" text-anchor=\"middle\">独立参考</text><path d=\"M835 514H780\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"808\" y=\"500\" class=\"case-flow-edge\" text-anchor=\"middle\">输出</text><path d=\"M665 388V470\" fill=\"none\" stroke=\"#527c77\" stroke-width=\"2.4\"  marker-end=\"url(#cf-wo1)\"/><text x=\"710\" y=\"435\" class=\"case-flow-edge\" text-anchor=\"middle\">同分母</text>\n </svg></div><figcaption>实线箭头连接计算与输出，虚线表示人工核查后的衔接。模型与基线的结果进入同条件对照；评价资料仅在评价环节使用。窄屏可左右滑动查看完整关系。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S1｜整理井史与本次观测</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"历史工单与本次观测分开阅读\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><circle cx=\"85\" cy=\"100\" r=\"10\" fill=\"#849496\"/><path d=\"M58 100H746\" stroke=\"#94aaa8\" stroke-width=\"4\"/><circle cx=\"290\" cy=\"100\" r=\"10\" fill=\"#849496\"/><path d=\"M58 100H746\" stroke=\"#94aaa8\" stroke-width=\"4\"/><circle cx=\"520\" cy=\"100\" r=\"10\" fill=\"#d18b4d\"/><path d=\"M58 100H746\" stroke=\"#94aaa8\" stroke-width=\"4\"/><circle cx=\"730\" cy=\"100\" r=\"10\" fill=\"#237c82\"/><text x=\"45\" y=\"55\">前次检修</text><text x=\"235\" y=\"55\">历史怀疑</text><text x=\"465\" y=\"55\">当前观测</text><text x=\"682\" y=\"55\">候选复核</text><text x=\"38\" y=\"148\">密封复查</text><text x=\"230\" y=\"148\">曾有环空描述</text><text x=\"445\" y=\"148\">压差 / 含砂 / 电流</text><text x=\"650\" y=\"148\">查看证据</text><rect x=\"60\" y=\"185\" width=\"680\" height=\"55\" rx=\"12\" fill=\"#f1e0cb\"/><text x=\"74\" y=\"218.5\">旧工单中的一个关键词，不等于本次故障的确认。</text></g></svg></div><figcaption>输入：文本、井号、压差、含砂、电流、沉积指标、环空压力；动作：保留历史时间作用域与缺失项；当前观测按单位录入；产物：带来源的查询记录。历史怀疑不能直接当作当前诊断。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S2｜按井分组与拟合词项</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"按独立井组拆分\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><rect x=\"30\" y=\"36\" width=\"230\" height=\"62\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"44\" y=\"73.0\">训练</text><text x=\"42\" y=\"133\">48口独立井</text><text x=\"42\" y=\"177\">拟合词项与尺度</text><rect x=\"285\" y=\"36\" width=\"230\" height=\"62\" rx=\"12\" fill=\"#f0dfc8\"/><text x=\"299\" y=\"73.0\">验证</text><text x=\"297\" y=\"133\">16口独立井</text><text x=\"297\" y=\"177\">选择检索配置</text><rect x=\"540\" y=\"36\" width=\"230\" height=\"62\" rx=\"12\" fill=\"#dce4ef\"/><text x=\"554\" y=\"73.0\">测试</text><text x=\"552\" y=\"133\">20口独立井</text><text x=\"552\" y=\"177\">仅评价</text><text x=\"35\" y=\"245\" font-size=\"17\">同一口井 / 储层组不跨集合；改写和试验点留在原组。</text></g></svg></div><figcaption>输入：48口训练井、16口验证井、20口测试井；动作：IDF和数值标准化只从训练井拟合；验证井选k、特征权重与接受线；产物：冻结词表、标准化参数和检索配置。重复改写不能分到测试井。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S3｜构造联合相似度</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"多源特征检索、候选约束与可追溯来源\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><rect x=\"28\" y=\"35\" width=\"210\" height=\"54\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"42\" y=\"68.0\">描述 → TF-IDF词项</text><rect x=\"28\" y=\"107\" width=\"210\" height=\"54\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"42\" y=\"140.0\">观测 → 标准化特征</text><path d=\"M240 62H300V100H355M240 134H300V100\" fill=\"none\" stroke=\"#638b91\" stroke-width=\"3\"/><rect x=\"355\" y=\"75\" width=\"200\" height=\"58\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"369\" y=\"110.0\">历史井近邻排序</text><rect x=\"585\" y=\"75\" width=\"185\" height=\"58\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"599\" y=\"110.0\">条件筛选</text><path d=\"M557 103H584\" stroke=\"#638b91\" stroke-width=\"3\"/><text x=\"40\" y=\"214\">相似度 = 文本余弦 × (1−w) + 观测相似度 × w</text><text x=\"40\" y=\"250\" font-size=\"17\">历史井编号与原文跟随候选；支持度不称作故障概率。</text></g></svg></div><figcaption>输入：当前文本词项与5项观测；动作：TF-IDF余弦与高斯型数值相似度加权；缺失值单列；产物：每口历史井的文本分与观测分。相似度未经概率校准。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S4｜检索候选与来源</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"近邻如何参与投票\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><rect x=\"30\" y=\"40\" width=\"200\" height=\"58\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"44\" y=\"75.0\">本次查询</text><path d=\"M232 70H310M310 70V210\" stroke=\"#78979a\" stroke-width=\"3\"/><rect x=\"350\" y=\"30\" width=\"410\" height=\"54\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"364\" y=\"63.0\">历史井 A：词项 + 观测</text><rect x=\"350\" y=\"107\" width=\"410\" height=\"54\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"364\" y=\"140.0\">历史井 B：词项 + 观测</text><rect x=\"350\" y=\"184\" width=\"410\" height=\"54\" rx=\"12\" fill=\"#e5e8f0\"/><text x=\"364\" y=\"217.0\">历史井 C：词项 + 观测</text></g></svg></div><figcaption>输入：冻结训练井库及查询向量；动作：取实际k个近邻，按方案类别累计支持；展示井号和原文；产物：近邻条形图、候选类别排序。没有近邻支持的类别不进入接受结果。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S5｜显式条件筛选</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"约束逐项核查\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><rect x=\"30\" y=\"35\" width=\"330\" height=\"52\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"44\" y=\"67.0\">完整性状态是否已确认？</text><rect x=\"30\" y=\"105\" width=\"330\" height=\"52\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"44\" y=\"137.0\">候选是否具备对应观测？</text><rect x=\"420\" y=\"35\" width=\"350\" height=\"52\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"434\" y=\"67.0\">满足 → 进入候选复核</text><rect x=\"420\" y=\"105\" width=\"350\" height=\"52\" rx=\"12\" fill=\"#f1e0cb\"/><text x=\"434\" y=\"137.0\">缺项 / 冲突 → 待补证</text><text x=\"40\" y=\"230\" font-size=\"17\">拒选原因始终显示，支持度高也不能越过显式条件。</text></g></svg></div><figcaption>输入：候选、完整性状态、含砂、电流与沉积证据；动作：逐项记录保留或拒选原因；信息不足时留待复核；产物：候选列表与拒选原因。条件筛选是规则，不混称学习模型。</figcaption></figure><figure class=\"figure\" style=\"margin:20px 0\"><h3>图 S6｜独立评价与人工复核</h3><div class=\"diagram-scroll\" tabindex=\"0\" style=\"max-width:100%;overflow-x:auto\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:block;width:100%;height:auto;min-width:720px\" viewBox=\"0 0 800 280\" role=\"img\" aria-label=\"原结果与人工意见分别保留\"><rect width=\"800\" height=\"280\" rx=\"20\" fill=\"#f1f5f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"18\" fill=\"#203448\"><rect x=\"25\" y=\"40\" width=\"225\" height=\"62\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"39\" y=\"77.0\">模型原候选</text><rect x=\"285\" y=\"40\" width=\"225\" height=\"62\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"299\" y=\"77.0\">人工确认 / 补证</text><rect x=\"545\" y=\"40\" width=\"230\" height=\"62\" rx=\"12\" fill=\"#dcebe7\"/><text x=\"559\" y=\"77.0\">带来源JSON</text><text x=\"40\" y=\"165\">测试集：分母20口井；拒判仍在Top-1分母中。</text><text x=\"40\" y=\"220\" font-size=\"17\">自由查询：显示近邻与约束，不产生虚构评价标签。</text></g></svg></div><figcaption>输入：20口测试井、自由查询和原始模型候选；动作：计算Top-1、Recall@3、覆盖率、出处覆盖；人工意见独立保存；产物：指标、混淆矩阵和当前JSON。自由改写无参考标签，不显示单条准确率。</figcaption></figure>"
      }
    },
    "demo": {
      "mode": "page",
      "html": "demo/index.html",
