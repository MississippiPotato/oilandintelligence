l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>把上提、下放等动作与钩载放在同一时间轴。</p><p>钩载是地面悬重测量。速度变化、加速减速都可能改变读数。本例用速度和阶段项解释正常载荷，把无法由动作解释的部分留作异常线索；不直接把高载荷等同井下事故。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"钩载与动作要一起读\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><polyline points=\"30,160 75,150 120,145 165,115 210,95 255,100 300,110 345,95 390,100 435,60 480,50 525,100 570,110 625,145 680,155\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><polyline points=\"30,165 75,150 120,145 165,120 210,100 255,105 300,110 345,100 390,105 435,100 480,100 525,105 570,115 625,145 680,160\" fill=\"none\" stroke=\"#94aaa9\" stroke-width=\"3\"/><text x=\"45\" y=\"35\">钩载 kN：实测与正常预测</text><text x=\"420\" y=\"190\">局部偏离 → 需要复核</text></g></svg><figcaption>实测钩载偏离正常关系时形成局部差距；普通提速也能推高整条曲线。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "METHOD",
          "title": "正常关系模型与持续残差",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>对照正常关系预测和残差，解释为什么固定载荷阈值容易受速度影响。</p><p>以60段独立正常作业片段拟合线性关系。当前片段的预测载荷不读取事件标签。实测减预测得到残差，连续3点超过阈值才合成一个报警区间；正常过程变化与局部异常由此分开显示。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"正常关系模型与持续残差\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><rect x=\"20\" y=\"30\" width=\"175\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"32\" y=\"58\">速度 + 阶段</text><rect x=\"255\" y=\"30\" width=\"180\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"267\" y=\"58\">预测正常载荷</text><rect x=\"500\" y=\"30\" width=\"195\" height=\"44\" rx=\"8\" fill=\"#dcebe7\"/><text x=\"512\" y=\"58\">实测减预测</text><polyline points=\"197,52 253,52\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><polyline points=\"437,52 498,52\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><text x=\"45\" y=\"130\">只有持续3点超限才形成报警区间</text><text x=\"45\" y=\"170\">整体漂移与局部事件会产生不同时间分布</text></g></svg><figcaption>把速度和阶段带入正常关系后，报警依据变成持续残差而非单一载荷。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "EVIDENCE",
          "title": "事件召回与误报分别看",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>将连续报警与事件起点对应，分别读召回和误报。</p><p>教学异常设在第65–79分钟，显示触发是否覆盖事件、首次报警相对事件开始的延迟，以及事件外报警点数。无异常时事件召回显示不适用。传感器漂移也会形成持续残差，提醒读者回查仪器与阶段，而非把模型分数当确诊。</p><p>默认数据为固定种子的教学构造数据，所有计算在浏览器本地执行。结果随当前参数生成，可导出JSON查看。</p><p>专业概念参考：<a href=\"https://www.osha.gov/etools/oil-and-gas/glossary-of-terms-c\" target=\"_blank\" rel=\"noopener\">专业机构原始资料</a>。</p></div>"
        },
        {
          "no": 4,
          "en": "LEARNING_TASK",
          "title": "课堂实验：一次只改变一个条件",
          "html": "<div class=\"xl-knowledge\"><aside class=\"learning-task\"><h3>动手前先提出判断</h3><p>先将异常附加载荷设为0、速度系数1.8，比较原阈值与残差法的事件外报警分钟。再恢复速度1、异常20kN，查看持续3点规则是否带来2分钟延迟；最后用无异常+漂移12kN说明“持续残差”也可能是传感器问题。事件为空时，召回显示不适用，继续查看事件外报警分钟。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>修井钩载随动作变化；用速度解释正常载荷后，再检查持续异常与事件时间。</h2><p>从一段修井动作记录出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>钩载与动作要一起读</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>正常关系模型与持续残差</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>事件召回与误报分别看</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "正常提速引起的载荷增加，怎样与异常阻力区分？",
      "lead": [
        "起下管柱时，钩载随运动阶段、速度和井下阻力变化。单一载荷上限容易在正常高速段报警，本例用正常作业关系预测载荷，再监测持续偏离。"
      ],
      "steps": [
        {
          "name": "记录速度和载荷",
          "role": "步骤 1",
          "do": "每分钟记录运动速度、阶段和钩载。当前120分钟片段含两段低速边界阶段与中间作业阶段，速度曲线和钩载一起输入。",
          "effect": "对齐时间轴的速度、阶段与载荷",
          "trap": "保留片段内时间顺序，按完整作业片段分组。"
        },
        {
          "name": "学习正常载荷关系",
          "role": "步骤 2",
          "do": "用60段独立正常片段拟合钩载=截距+速度项+阶段项。训练只使用正常关系，当前测试片段不参加拟合。",
          "effect": "正常条件下的预测载荷曲线",
          "trap": "从正常片段拟合载荷关系，再监测当前残差。"
        },
        {
          "name": "连续残差形成事件",
          "role": "步骤 3",
          "do": "当前实测钩载减去预测钩载。连续3个残差超过输入阈值时，第三点开始报警，避免单点噪声直接触发事件。",
          "effect": "报警时间带和残差阈值",
          "trap": "持续整体漂移出现时，同时回查传感器。"
        },
        {
          "name": "核查报警时间与漂移",
          "role": "步骤 4",
          "do": "用参考事件区间计算是否检出和延迟，统计区间外报警分钟。对照方法仅判断钩载是否超过108kN；调高速度可观察正常高载荷带来的差异。",
          "effect": "事件召回、延迟和误报分钟",
          "trap": "事件为空时，召回显示不适用，保留事件外报警计数。"
        }
      ],
      "metrics": {
        "title": "步骤的输入与产物",
        "html": "<style>/* Applied only to the56 expansion lessons; data-category colors are preserved. */\n.xl-lesson,.xl-parent{--xl-red:#b8242a;--xl-paper:#f7f4ef;--xl-ink:#292d34;--xl-muted:#66717d;--xl-line:#e6dfd7;color:var(--xl-ink);font-size:18px;line-height:1.85}\nbody.xl-lesson{margin:0;background:var(--xl-paper);font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}\n.xl-lesson>header{max-width:1180px;margin:28px auto 0;padding:32px 38px 20px;background:#fff;border:1px solid var(--xl-line);border-radius:24px;box-shadow:0 8px 30px #3b282608}\n.xl-lesson>header h1{color:#292d34;font-size:clamp(25px,2.6vw,36px);line-height:1.5;max-width:1000px;margin:12px 0}\n.xl-lesson>main{max-width:1180px;margin:24px auto 70px;padding:0 0 25px;min-width:0}\n.xl-lesson>header nav{position:static;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;padding:14px 0 0;margin:14px 0 0}\n.xl-lesson>nav{max-width:1180px;margin:18px auto;padding:0 10px;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;position:static}\n.xl-lesson>nav button[aria-selected=\"true\"]{background:var(--xl-red);border-color:var(--xl-red);color:white}\n.xl-lesson>header nav button,.xl-lesson button,.xl-parent button{font:inherit;line-height:1.5;min-height:44px;cursor:pointer}\n.xl-lesson button,.xl-parent .xl-step-nav button,.xl-parent .xl-next button{background:#fff;color:#4d4343;border:1px solid #ddd5d0;border-radius:13px;padding:10px 17px;transition:background .15s,border-color .15s,box-shadow .15s}\n.xl-lesson button:hover,.xl-parent .xl-step-nav button:hover{border-color:var(--xl-red);background:#fff8f5}\n.xl-lesson button.primary,.xl-lesson button.active,.xl-lesson header nav button[aria-pressed=\"true\"],.xl-lesson header nav button[aria-selected=\"true\"],.xl-step-nav button[aria-selected=\"true\"],.xl-parent .xl-next button{background:var(--xl-red);color:white;border-color:var(--xl-red)}\n.xl-lesson button:disabled{opacity:.45;cursor:default}\n.xl-lesson :focus-visible,.xl-parent :focus-visible{outline:3px solid #b8242a88;outline-offset:4px}\n.xl-lesson input,.xl-lesson select,.xl-lesson textarea{font:inherit;min-width:0;max-width:100%;accent-color:var(--xl-red);border-radius:9px}\n.xl-lesson input[type=range]{width:100%}.xl-lesson label{font-size:17px;color:#45434a}\n.xl-lesson p{max-width:100%;overflow-wrap:anywhere}\n.xl-lesson .intro,.xl-lesson .note,.xl-lesson .small,.xl-lesson .data-note,.xl-lesson .legend,.xl-lesson figcaption,.xl-parent figcaption,.xl-parent .note{font-size:16px;line-height:1.8;color:#64707a}\n.xl-lesson .source-badge,.xl-kicker{font-size:13px;letter-spacing:.1em;color:var(--xl-red);font-weight:700;text-transform:uppercase}\n.xl-lesson .brand,.xl-lesson .eyebrow,.xl-lesson .tag,.xl-lesson .kicker,.xl-lesson output,.xl-lesson>header a{color:var(--xl-red)}\n.xl-parent #tabs .tab.on{background:var(--xl-red);border-color:var(--xl-red);color:#fff}\n.xl-lesson h2,.xl-parent .xl-opening h2{font-size:25px;line-height:1.55;color:#292d34;margin:12px 0 20px}\n.xl-lesson h3{font-size:21px;color:#333842;line-height:1.55}\n.xl-lesson .card,.xl-lesson .panel,.xl-lesson .reading-block,.xl-lesson .plot-grid>article,.xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide{background:#fff;border:1px solid var(--xl-line);border-radius:20px;box-shadow:0 5px 22px #382b2105;padding:26px 30px;margin:20px 0}\n.xl-opening{padding:28px 32px;background:linear-gradient(120deg,#fff 60%,#fff3ed)}\n.xl-opening h2{max-width:960px;font-size:27px;font-weight:650;line-height:1.65}\n.xl-opening>p{margin-bottom:0;color:var(--xl-muted)}\n.xl-reading-path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0 2px}\n.xl-reading-path a{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;background:#fff;border:1px solid #ece3dd;border-radius:14px;color:#4d4343;text-decoration:none;line-height:1.6;font-size:16px}\n.xl-reading-path a span{font-size:13px;color:var(--xl-red);font-weight:750}\n.xl-read{padding:13px 17px;border-left:3px solid var(--xl-red);background:#fbf6f1;color:#5d4f49;font-size:16px;line-height:1.8;border-radius:0 10px 10px 0}\n.xl-read b{display:block;color:var(--xl-red);font-size:13px;letter-spacing:.05em;margin-bottom:4px}\n.xl-chapter{scroll-margin-top:22px}\n.xl-knowledge>p{margin:20px 0}.xl-knowledge>p.xl-read{margin:0 0 22px}\n.xl-knowledge figure{margin:24px 0}.xl-knowledge svg,.xl-method-step svg{display:block;width:100%;max-width:900px;max-height:280px;height:auto;margin:18px auto}\n.xl-knowledge img{max-width:100%;height:auto;border-radius:12px}\n.xl-diagram,.xl-data-plot{max-width:100%;min-width:0;overflow:auto}.xl-diagram-hint{display:none}\n.xl-method>.case-flow-overview,.xl-parent .case-flow-overview{margin:20px 0;background:#fff;border:1px solid var(--xl-line);border-radius:20px;padding:20px;box-shadow:none}\n.xl-method .case-flow-overview svg{max-height:300px;width:100%;height:auto}\n.xl-step-nav{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 14px}\n.xl-step-nav button{font-size:16px;border-radius:12px;padding:10px 13px}\n.xl-step-heading{display:flex;align-items:center;gap:18px;margin-bottom:18px}.xl-step-heading h3{margin:0;font-size:24px}\n.xl-action-copy>b,.xl-products b{font-size:14px;color:var(--xl-red)}.xl-action-copy p{margin:7px 0 24px}\n.xl-products{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--xl-line);padding-top:18px;margin-top:22px}\n.xl-products p{font-size:17px;margin:7px 0}.xl-next{display:flex;justify-content:flex-end;margin:22px 0}\n.xl-lab-guide{border-top:3px solid var(--xl-red);padding:22px 28px}\n.xl-lab-guide h2{margin:4px 0 10px;font-size:23px}.xl-lab-guide>p{margin:8px 0 16px;color:#645f61;font-size:17px}\n.xl-task-actions{display:flex;gap:10px;flex-wrap:wrap}.xl-task-actions button{font-size:16px}\n.xl-task-actions button[aria-pressed=\"true\"]{background:#fbebeb;border-color:#c27b7e;color:#9c2026}\n.xl-task-look{padding-top:14px;border-top:1px solid var(--xl-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>正常提速引起的载荷增加，怎样与异常阻力区分？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"wo4\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"动作与载荷风险\"><defs><marker id=\"cf-wo4\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-wo4)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">速度阶段与钩载</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">每分钟时序对齐</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立正常片段</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">学习速度及阶段项</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">预测正常载荷</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">当前不读事件标签</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">钩载阈值基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">阈值一百零八千牛</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">持续偏离有原因？回查动作和仪器</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">连续三点残差</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">也可能传感器漂移</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">载荷残差双图</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">阶段及报警对齐</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">事件独立评价</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">召回延迟误报分钟</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 记录速度和载荷</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 学习正常载荷关系</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 连续残差形成事件</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-3\" data-xl-step=\"3\">04 核查报警时间与漂移</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 4</span><h3>记录速度和载荷</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>每分钟记录运动速度、阶段和钩载。当前120分钟片段含两段低速边界阶段与中间作业阶段，速度曲线和钩载一起输入。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F1：记录速度和载荷的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 1｜记录速度和载荷</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：每分钟记录运动速度、阶段和钩载。当前120分钟片段含两段低速边界阶段</text><text x=\"42\" y=\"113\" font-size=\"16\">与中间作业阶段，速度曲线和钩载一起输入。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：对齐时间轴的速度、阶段与载荷</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：保留片段内时间顺序，按完整作业片段分组。</text></g></svg><figcaption>图 F1：记录速度和载荷的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>对齐时间轴的速度、阶段与载荷</p></div><div><b>理解这一步</b><p>保留片段内时间顺序，按完整作业片段分组。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 4</span><h3>学习正常载荷关系</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>用60段独立正常片段拟合钩载=截距+速度项+阶段项。训练只使用正常关系，当前测试片段不参加拟合。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F2：学习正常载荷关系的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 2｜学习正常载荷关系</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：用60段独立正常片段拟合钩载=截距+速度项+阶段项。训练只使用正常关</text><text x=\"42\" y=\"113\" font-size=\"16\">系，当前测试片段不参加拟合。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：正常条件下的预测载荷曲线</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：从正常片段拟合载荷关系，再监测当前残差。</text></g></svg><figcaption>图 F2：学习正常载荷关系的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>正常条件下的预测载荷曲线</p></div><div><b>理解这一步</b><p>从正常片段拟合载荷关系，再监测当前残差。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 4</span><h3>连续残差形成事件</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>当前实测钩载减去预测钩载。连续3个残差超过输入阈值时，第三点开始报警，避免单点噪声直接触发事件。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F3：连续残差形成事件的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 3｜连续残差形成事件</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：当前实测钩载减去预测钩载。连续3个残差超过输入阈值时，第三点开始报警</text><text x=\"42\" y=\"113\" font-size=\"16\">，避免单点噪声直接触发事件。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：报警时间带和残差阈值</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：持续整体漂移出现时，同时回查传感器。</text></g></svg><figcaption>图 F3：连续残差形成事件的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>报警时间带和残差阈值</p></div><div><b>理解这一步</b><p>持续整体漂移出现时，同时回查传感器。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-3\" data-xl-panel=\"3\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">04 / 4</span><h3>核查报警时间与漂移</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>用参考事件区间计算是否检出和延迟，统计区间外报警分钟。对照方法仅判断钩载是否超过108kN；调高速度可观察正常高载荷带来的差异。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F4：核查报警时间与漂移的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 4｜核查报警时间与漂移</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：用参考事件区间计算是否检出和延迟，统计区间外报警分钟。对照方法仅判断</text><text x=\"42\" y=\"113\" font-size=\"16\">钩载是否超过108kN；调高速度可观察正常高载荷带来的差异。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：事件召回、延迟和误报分钟</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：事件为空时，召回显示不适用，保留事件外报警计数。</text></g></svg><figcaption>图 F4：核查报警时间与漂移的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>事件召回、延迟和误报分钟</p></div><div><b>理解这一步</b><p>事件为空时，召回显示不适用，保留事件外报警计数。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
      },
      "lessonHTML": "<div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>正常提速引起的载荷增加，怎样与异常阻力区分？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"wo4\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"动作与载荷风险\"><defs><marker id=\"cf-wo4\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-wo4)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-wo4)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">速度阶段与钩载</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">每分钟时序对齐</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立正常片段</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">学习速度及阶段项</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">预测正常载荷</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">当前不读事件标签</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">钩载阈值基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">阈值一百零八千牛</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">持续偏离有原因？回查动作和仪器</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">连续三点残差</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">也可能传感器漂移</text></g><g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">载荷残差双图</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">阶段及报警对齐</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">事件独立评价</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">召回延迟误报分钟</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 记录速度和载荷</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 学习正常载荷关系</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 连续残差形成事件</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-3\" data-xl-step=\"3\">04 核查报警时间与漂移</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 4</span><h3>记录速度和载荷</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>每分钟记录运动速度、阶段和钩载。当前120分钟片段含两段低速边界阶段与中间作业阶段，速度曲线和钩载一起输入。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F1：记录速度和载荷的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 1｜记录速度和载荷</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：每分钟记录运动速度、阶段和钩载。当前120分钟片段含两段低速边界阶段</text><text x=\"42\" y=\"113\" font-size=\"16\">与中间作业阶段，速度曲线和钩载一起输入。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：对齐时间轴的速度、阶段与载荷</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：保留片段内时间顺序，按完整作业片段分组。</text></g></svg><figcaption>图 F1：记录速度和载荷的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>对齐时间轴的速度、阶段与载荷</p></div><div><b>理解这一步</b><p>保留片段内时间顺序，按完整作业片段分组。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 4</span><h3>学习正常载荷关系</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>用60段独立正常片段拟合钩载=截距+速度项+阶段项。训练只使用正常关系，当前测试片段不参加拟合。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F2：学习正常载荷关系的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 2｜学习正常载荷关系</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：用60段独立正常片段拟合钩载=截距+速度项+阶段项。训练只使用正常关</text><text x=\"42\" y=\"113\" font-size=\"16\">系，当前测试片段不参加拟合。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：正常条件下的预测载荷曲线</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：从正常片段拟合载荷关系，再监测当前残差。</text></g></svg><figcaption>图 F2：学习正常载荷关系的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>正常条件下的预测载荷曲线</p></div><div><b>理解这一步</b><p>从正常片段拟合载荷关系，再监测当前残差。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 4</span><h3>连续残差形成事件</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>当前实测钩载减去预测钩载。连续3个残差超过输入阈值时，第三点开始报警，避免单点噪声直接触发事件。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F3：连续残差形成事件的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 3｜连续残差形成事件</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：当前实测钩载减去预测钩载。连续3个残差超过输入阈值时，第三点开始报警</text><text x=\"42\" y=\"113\" font-size=\"16\">，避免单点噪声直接触发事件。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：报警时间带和残差阈值</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：持续整体漂移出现时，同时回查传感器。</text></g></svg><figcaption>图 F3：连续残差形成事件的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>报警时间带和残差阈值</p></div><div><b>理解这一步</b><p>持续整体漂移出现时，同时回查传感器。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-3\" data-xl-panel=\"3\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">04 / 4</span><h3>核查报警时间与漂移</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>用参考事件区间计算是否检出和延迟，统计区间外报警分钟。对照方法仅判断钩载是否超过108kN；调高速度可观察正常高载荷带来的差异。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F4：核查报警时间与漂移的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 4｜核查报警时间与漂移</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：用参考事件区间计算是否检出和延迟，统计区间外报警分钟。对照方法仅判断</text><text x=\"42\" y=\"113\" font-size=\"16\">钩载是否超过108kN；调高速度可观察正常高载荷带来的差异。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：事件召回、延迟和误报分钟</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：事件为空时，召回显示不适用，保留事件外报警计数。</text></g></svg><figcaption>图 F4：核查报警时间与漂移的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>事件召回、延迟和误报分钟</p></div><div><b>理解这一步</b><p>事件为空时，召回显示不适用，保留事件外报警计数。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
    },
