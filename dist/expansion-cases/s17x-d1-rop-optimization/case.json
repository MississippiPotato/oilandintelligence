=\"1\"/><rect x=\"408\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#63b29b\" opacity=\"1\"/><rect x=\"408\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"408\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"408\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"461\" y=\"55\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#63b29b\" opacity=\"0.35\"/><rect x=\"461\" y=\"86\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#63b29b\" opacity=\"1\"/><rect x=\"461\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"461\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"461\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"461\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"1\"/><rect x=\"514\" y=\"55\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#63b29b\" opacity=\"0.35\"/><rect x=\"514\" y=\"86\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"514\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"514\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"1\"/><rect x=\"514\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"1\"/><rect x=\"514\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"1\"/><rect x=\"567\" y=\"55\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"567\" y=\"86\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"567\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"567\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"567\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"567\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"620\" y=\"55\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"620\" y=\"86\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"620\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"620\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"620\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"620\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"673\" y=\"55\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#238b7e\" opacity=\"0.35\"/><rect x=\"673\" y=\"86\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"673\" y=\"117\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"673\" y=\"148\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"673\" y=\"179\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><rect x=\"673\" y=\"210\" width=\"50\" height=\"28\" rx=\"3\" fill=\"#12635f\" opacity=\"0.35\"/><path d=\"M560 45L560 253\" fill=\"none\" stroke=\"#cc654f\" stroke-width=\"3\" stroke-dasharray=\"7 5\"/><text x=\"590\" y=\"44\" font-size=\"22\" fill=\"#cc654f\">钻压上限</text><circle cx=\"534\" cy=\"194\" r=\"15\" fill=\"none\" stroke=\"#17343f\" stroke-width=\"5\"/><text x=\"100\" y=\"281\" font-size=\"20\" fill=\"#17343f\">WOB →</text><text x=\"23\" y=\"82\" font-size=\"20\" fill=\"#17343f\">RPM</text><text x=\"662\" y=\"235\" font-size=\"23\" fill=\"#17343f\">○ 可行候选</text><text x=\"662\" y=\"270\" font-size=\"20\" fill=\"#17343f\">浅色：约束排除</text></g></svg></div><figcaption>图 B3 · 寻找快的区域，同时看到边界</figcaption></figure><p>专业依据：<a href=\"https://glossary.slb.com/terms/r/rate_of_penetration\" target=\"_blank\" rel=\"noopener\">SLB｜Rate of penetration</a>；<a href=\"https://glossary.slb.com/terms/b/bha\" target=\"_blank\" rel=\"noopener\">SLB｜Bottomhole assembly</a>；<a href=\"https://investorcenter.slb.com/static-files/41a10f14-81ca-442f-83f6-05dae85b6f67\" target=\"_blank\" rel=\"noopener\">SLB｜Optimizing Drilling Rate of Penetration</a>。图示与默认数值由本案例重新构造。</p>"
