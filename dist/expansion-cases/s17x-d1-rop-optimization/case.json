    "workflow": {
      "label": "案例流程",
      "title": "钻得更快，也要留在约束内。",
      "lead": [
        "从多口教学井学习钻速响应，比较单钻压经验基线，再在钻压、转速、流量、泵压与扭矩边界内搜索参数。你可以收紧约束、放大噪声，或进入更硬地层的迁移情景。"
      ],
      "stats": [
        [
          "步骤",
          "5"
        ],
        [
          "测试井",
          "2 口"
        ],
        [
          "运行",
          "纯前端离线"
        ]
      ],
      "steps": [
        {
          "name": "按整井分开数据",
          "role": "图 S1",
          "do": "输入：13 口教学井的工况与钻速；动作：8 口训练、3 口验证、2 口测试；保留整井身份。见图 S1。",
          "effect": "512 / 192 / 128 条记录",
          "trap": "随机拆散同井样本会低估迁移难度。"
        },
        {
          "name": "拟合一个可解释的钻速代理",
          "role": "图 S2",
          "do": "输入：训练井 WOB、RPM、Q、UCS 和 ROP；动作：训练集标准化，使用一次项、平方项和交互项拟合岭回归。见图 S2。",
          "effect": "冻结标准化参数与回归系数",
          "trap": "系数说明统计关系，不能直接当作因果效应。"
        },
        {
          "name": "用验证井选择正则强度",
          "role": "图 S3",
          "do": "输入：4 个候选 λ 与同一验证集；动作：分别计算验证 RMSE，保留误差最小的模型。见图 S3。",
          "effect": "λ、4 个验证分数和基线系数",
          "trap": "测试指标只报告，不反过来自动选择模型。"
        },
        {
          "name": "在可行域内搜索参数",
          "role": "图 S4",
          "do": "输入：冻结代理 + WOB/RPM/Q 网格与 5 项约束；动作：逐点预测 ROP；计算泵压、扭矩；排序合格点。见图 S4。",
          "effect": "2,145 点、可行点计数与候选设置",
          "trap": "关闭约束后仍显示违反项；不能隐藏代价。"
        },
        {
          "name": "比较留出误差，留下复核依据",
          "role": "图 S5",
          "do": "输入：两口测试井与冻结推荐点；动作：同数据比较多变量模型与单 WOB 基线；推荐冻结后再计算教学实现值。见图 S5。",
          "effect": "RMSE、MAE、误差位置、约束余量与人工记录",
          "trap": "代理高估的点要检查；模拟实现值与代理预测分列。"
        }
      ],
      "metrics": {
