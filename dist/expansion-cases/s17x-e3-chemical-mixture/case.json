l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>从驱替路径认识配方改善流动的作用。</p><p>常规水驱中，水与原油流动能力不同，可能更容易沿高渗通道前进而绕过部分油。聚合物驱利用水相增黏改善流度控制，表面活性剂体系可降低油水界面张力；两类作用分别涉及波及范围与驱替效率。本例用虚构母液A、B和载液C练习配方比例与成本筛选。三元图内部任一点都满足a+b+c=1，顶点表示单一组分。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"先理解化学驱，再阅读配方空间\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><path d=\"M60 175L250 25L440 175Z\" fill=\"#dcebe7\" stroke=\"#247d83\" stroke-width=\"3\"/><text x=\"40\" y=\"200\">C载液</text><text x=\"235\" y=\"22\">A</text><text x=\"450\" y=\"180\">B</text><circle cx=\"250\" cy=\"125\" r=\"8\" fill=\"#be8952\"/><text x=\"480\" y=\"70\">任一点：a+b+c=1</text><text x=\"480\" y=\"115\">边上：一个组分为0</text><text x=\"480\" y=\"160\">顶点：单一组分</text></g></svg><figcaption>三角形每个点都是比例总和1的配方；移动点会同时改变三种比例。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "METHOD",
          "title": "性能与环境共同作用",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>在配方空间比较性能与环境条件，三角坐标的三个比例始终加和为1。</p><p>盐度变化可能改变化学体系响应。因此相同比例在不同盐度下并非同样有效。模型从试验数据学习二次混合项和盐度交互，输出教学驱替改善指数；成本由各组分单价按比例直接计算。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 210\" role=\"img\" aria-label=\"性能与环境共同作用\"><rect width=\"720\" height=\"210\" rx=\"12\" fill=\"#f0f5f4\"/><g fill=\"#254755\" font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\"><polyline points=\"40,175 110,150 180,115 250,85 320,65 390,55\" fill=\"none\" stroke=\"#247d83\" stroke-width=\"3\"/><polyline points=\"40,175 110,155 180,135 250,125 320,120 390,135\" fill=\"none\" stroke=\"#b78451\" stroke-width=\"3\"/><text x=\"450\" y=\"80\">同一比例，不同盐度</text><text x=\"450\" y=\"125\">性能曲线会改变</text><text x=\"450\" y=\"170\">成本仍由比例直接加权</text></g></svg><figcaption>盐度改变响应曲线，配方成本仍须按已知组分单价单独核算。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "EVIDENCE",
          "title": "先验证代理，再搜索可行配方",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>先读留出误差，再看满足预算的可行配方。</p><p>140批训练试验拟合代理，45批独立试验计算MAE。随后枚举231个比例点，逐个检查预算，在可行点里选预测指数最高者。固定配方也按相同成本和代理评价；若它超预算，会明确显示超限。</p><p>默认数据为固定种子的教学构造数据，所有计算在浏览器本地执行。结果随当前参数生成，可导出JSON查看。</p><p>专业概念参考：<a href=\"https://www.sodir.no/en/facts/production/improved-oil-recovery-ior/enhanced-oil-recovery-EOR/water-based-methods/\" target=\"_blank\" rel=\"noopener\">专业机构原始资料</a>。</p></div>"
        },
        {
          "no": 4,
          "en": "LEARNING_TASK",
          "title": "课堂实验：一次只改变一个条件",
          "html": "<div class=\"xl-knowledge\"><aside class=\"learning-task\"><h3>动手前先提出判断</h3><p>保持盐度30g/L，分别用预算5与6元/L运行，在三元图读出圈中配方的A/B/C比例、成本和预测指数。点选固定方块(0.30/0.30/0.40)，核算0.3×9+0.3×6+0.4×1.5=5.10元/L，说明预算5时为何超限。再固定预算6、盐度改70，观察最优点移动而单价不变。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>化学驱配方的效果依赖环境；先检查性能代理，再在盐度与预算条件下筛配方。</h2><p>从一个化学驱配方点出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>先理解化学驱，再阅读配方空间</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>性能与环境共同作用</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>先验证代理，再搜索可行配方</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "提高性能时，怎样同时看见配方成本与盐度影响？",
      "lead": [
        "化学驱通过改变流体性质改善驱替。把三种教学母液A、B与载液C的比例限制为总和1，利用小型试验学习响应，再筛出预算内候选。"
      ],
      "steps": [
        {
          "name": "整理比例与盐度试验",
          "role": "步骤 1",
          "do": "每批试验保留A、B比例与盐度，C比例由1−A−B确定。训练与留出按不同试验批次生成，响应指数有独立噪声。",
          "effect": "140批训练、45批测试与固定比例约束",
          "trap": "A、B为虚构母液，C为载液，用三元比例练习筛选。"
        },
        {
          "name": "学习混合响应代理",
          "role": "步骤 2",
          "do": "二次回归包括A²、B²、AB和盐度交互，学习同一比例在不同盐度下的响应变化。训练均值是独立对照。",
          "effect": "冻结性能代理和留出MAE",
          "trap": "性能栏显示代理预测值，留出误差单独列出。"
        },
        {
          "name": "枚举单纯形并查成本",
          "role": "步骤 3",
          "do": "以0.05为比例步长枚举231点，每个点满足比例总和1。按单价9、6、1.5元/L直接加权计算成本，超预算点灰显。",
          "effect": "三元配方图上的真实可行域",
          "trap": "先按成本约束筛选，再在可行配方中比较性能。"
        },
        {
          "name": "比较可行性能与基线",
          "role": "步骤 4",
          "do": "只在可行点中按预测性能排序，圈出当前最佳；固定0.3/0.3/0.4配方以方块标出。改变盐度或预算后重新计算图中颜色与最优点；色标固定−20–80，便于跨盐度比较。三元图上顶A、左下C、右下B，20%网格用于读比例，单点步长5%。",
          "effect": "当前候选、固定配方和约束计数",
          "trap": "固定配方成本为5.10元/L，与同一预算逐项比较。"
        }
      ],
      "metrics": {
        "title": "步骤的输入与产物",
        "html": "<style>/* Applied only to the56 expansion lessons; data-category colors are preserved. */\n.xl-lesson,.xl-parent{--xl-red:#b8242a;--xl-paper:#f7f4ef;--xl-ink:#292d34;--xl-muted:#66717d;--xl-line:#e6dfd7;color:var(--xl-ink);font-size:18px;line-height:1.85}\nbody.xl-lesson{margin:0;background:var(--xl-paper);font-family:\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif}\n.xl-lesson>header{max-width:1180px;margin:28px auto 0;padding:32px 38px 20px;background:#fff;border:1px solid var(--xl-line);border-radius:24px;box-shadow:0 8px 30px #3b282608}\n.xl-lesson>header h1{color:#292d34;font-size:clamp(25px,2.6vw,36px);line-height:1.5;max-width:1000px;margin:12px 0}\n.xl-lesson>main{max-width:1180px;margin:24px auto 70px;padding:0 0 25px;min-width:0}\n.xl-lesson>header nav{position:static;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;padding:14px 0 0;margin:14px 0 0}\n.xl-lesson>nav{max-width:1180px;margin:18px auto;padding:0 10px;display:flex;gap:8px;flex-wrap:wrap;background:transparent;border:0;position:static}\n.xl-lesson>nav button[aria-selected=\"true\"]{background:var(--xl-red);border-color:var(--xl-red);color:white}\n.xl-lesson>header nav button,.xl-lesson button,.xl-parent button{font:inherit;line-height:1.5;min-height:44px;cursor:pointer}\n.xl-lesson button,.xl-parent .xl-step-nav button,.xl-parent .xl-next button{background:#fff;color:#4d4343;border:1px solid #ddd5d0;border-radius:13px;padding:10px 17px;transition:background .15s,border-color .15s,box-shadow .15s}\n.xl-lesson button:hover,.xl-parent .xl-step-nav button:hover{border-color:var(--xl-red);background:#fff8f5}\n.xl-lesson button.primary,.xl-lesson button.active,.xl-lesson header nav button[aria-pressed=\"true\"],.xl-lesson header nav button[aria-selected=\"true\"],.xl-step-nav button[aria-selected=\"true\"],.xl-parent .xl-next button{background:var(--xl-red);color:white;border-color:var(--xl-red)}\n.xl-lesson button:disabled{opacity:.45;cursor:default}\n.xl-lesson :focus-visible,.xl-parent :focus-visible{outline:3px solid #b8242a88;outline-offset:4px}\n.xl-lesson input,.xl-lesson select,.xl-lesson textarea{font:inherit;min-width:0;max-width:100%;accent-color:var(--xl-red);border-radius:9px}\n.xl-lesson input[type=range]{width:100%}.xl-lesson label{font-size:17px;color:#45434a}\n.xl-lesson p{max-width:100%;overflow-wrap:anywhere}\n.xl-lesson .intro,.xl-lesson .note,.xl-lesson .small,.xl-lesson .data-note,.xl-lesson .legend,.xl-lesson figcaption,.xl-parent figcaption,.xl-parent .note{font-size:16px;line-height:1.8;color:#64707a}\n.xl-lesson .source-badge,.xl-kicker{font-size:13px;letter-spacing:.1em;color:var(--xl-red);font-weight:700;text-transform:uppercase}\n.xl-lesson .brand,.xl-lesson .eyebrow,.xl-lesson .tag,.xl-lesson .kicker,.xl-lesson output,.xl-lesson>header a{color:var(--xl-red)}\n.xl-parent #tabs .tab.on{background:var(--xl-red);border-color:var(--xl-red);color:#fff}\n.xl-lesson h2,.xl-parent .xl-opening h2{font-size:25px;line-height:1.55;color:#292d34;margin:12px 0 20px}\n.xl-lesson h3{font-size:21px;color:#333842;line-height:1.55}\n.xl-lesson .card,.xl-lesson .panel,.xl-lesson .reading-block,.xl-lesson .plot-grid>article,.xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide{background:#fff;border:1px solid var(--xl-line);border-radius:20px;box-shadow:0 5px 22px #382b2105;padding:26px 30px;margin:20px 0}\n.xl-opening{padding:28px 32px;background:linear-gradient(120deg,#fff 60%,#fff3ed)}\n.xl-opening h2{max-width:960px;font-size:27px;font-weight:650;line-height:1.65}\n.xl-opening>p{margin-bottom:0;color:var(--xl-muted)}\n.xl-reading-path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0 2px}\n.xl-reading-path a{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;background:#fff;border:1px solid #ece3dd;border-radius:14px;color:#4d4343;text-decoration:none;line-height:1.6;font-size:16px}\n.xl-reading-path a span{font-size:13px;color:var(--xl-red);font-weight:750}\n.xl-read{padding:13px 17px;border-left:3px solid var(--xl-red);background:#fbf6f1;color:#5d4f49;font-size:16px;line-height:1.8;border-radius:0 10px 10px 0}\n.xl-read b{display:block;color:var(--xl-red);font-size:13px;letter-spacing:.05em;margin-bottom:4px}\n.xl-chapter{scroll-margin-top:22px}\n.xl-knowledge>p{margin:20px 0}.xl-knowledge>p.xl-read{margin:0 0 22px}\n.xl-knowledge figure{margin:24px 0}.xl-knowledge svg,.xl-method-step svg{display:block;width:100%;max-width:900px;max-height:280px;height:auto;margin:18px auto}\n.xl-knowledge img{max-width:100%;height:auto;border-radius:12px}\n.xl-diagram,.xl-data-plot{max-width:100%;min-width:0;overflow:auto}.xl-diagram-hint{display:none}\n.xl-method>.case-flow-overview,.xl-parent .case-flow-overview{margin:20px 0;background:#fff;border:1px solid var(--xl-line);border-radius:20px;padding:20px;box-shadow:none}\n.xl-method .case-flow-overview svg{max-height:300px;width:100%;height:auto}\n.xl-step-nav{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 14px}\n.xl-step-nav button{font-size:16px;border-radius:12px;padding:10px 13px}\n.xl-step-heading{display:flex;align-items:center;gap:18px;margin-bottom:18px}.xl-step-heading h3{margin:0;font-size:24px}\n.xl-action-copy>b,.xl-products b{font-size:14px;color:var(--xl-red)}.xl-action-copy p{margin:7px 0 24px}\n.xl-products{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--xl-line);padding-top:18px;margin-top:22px}\n.xl-products p{font-size:17px;margin:7px 0}.xl-next{display:flex;justify-content:flex-end;margin:22px 0}\n.xl-lab-guide{border-top:3px solid var(--xl-red);padding:22px 28px}\n.xl-lab-guide h2{margin:4px 0 10px;font-size:23px}.xl-lab-guide>p{margin:8px 0 16px;color:#645f61;font-size:17px}\n.xl-task-actions{display:flex;gap:10px;flex-wrap:wrap}.xl-task-actions button{font-size:16px}\n.xl-task-actions button[aria-pressed=\"true\"]{background:#fbebeb;border-color:#c27b7e;color:#9c2026}\n.xl-task-look{padding-top:14px;border-top:1px solid var(--xl-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>提高性能时，怎样同时看见配方成本与盐度影响？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"e3\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"配方成本与盐度\"><defs><marker id=\"cf-e3\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0L6 3L0 6Z\" fill=\"#78958b\"/></marker></defs>\n <path d=\"M210 65H230\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><path d=\"M420 65H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><path d=\"M630 65H670\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><path d=\"M800 65H880\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><text x=\"840\" y=\"53\" text-anchor=\"middle\" class=\"case-flow-edge\">可继续</text><path d=\"M735 110V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><text x=\"775\" y=\"130\" text-anchor=\"middle\" class=\"case-flow-edge\">需核查</text><path d=\"M325 95V170H440\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><text x=\"380\" y=\"159\" text-anchor=\"middle\" class=\"case-flow-edge\">同一观测</text><path d=\"M860 170H870V120H975V95\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\" stroke-dasharray=\"5 4\" marker-end=\"url(#cf-e3)\"/><text x=\"927\" y=\"132\" text-anchor=\"middle\" class=\"case-flow-edge\">确认后</text><path d=\"M975 95V140\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><path d=\"M535 195V222H975V195\" fill=\"none\" stroke=\"#78958b\" stroke-width=\"1.8\"  marker-end=\"url(#cf-e3)\"/><text x=\"750\" y=\"239\" text-anchor=\"middle\" class=\"case-flow-edge\">同条件对照</text>\n <g class=\"case-flow-node\" data-flow-step=\"0\" data-flow-node=\"input\" transform=\"translate(20 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eef2ed\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">母液比例与盐度</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">比例和恒为一</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"prepare\" transform=\"translate(230 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">独立试验批次</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">二次混合盐度交互</text></g><g class=\"case-flow-node\" data-flow-step=\"1\" data-flow-node=\"model\" transform=\"translate(440 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">性能回归代理</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">冻结后搜索配方</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"baseline\" transform=\"translate(440 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f4efe4\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">固定比例基线</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">成本五点一元每升</text></g>\n <g class=\"case-flow-node\" data-flow-node=\"gate\" data-flow-step=\"2\"><polygon points=\"735,20 800,65 735,110 670,65\" fill=\"#fbf0d9\"/><text x=\"735\" y=\"71\" text-anchor=\"middle\" class=\"case-flow-title\">当前配方满足预算？调整预算再计算</text></g>\n <g class=\"case-flow-node\" data-flow-step=\"2\" data-flow-node=\"review\" transform=\"translate(670 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#f6eade\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">网格逐点查成本</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">已知单价线性加权</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"output\" transform=\"translate(880 30)\"><rect width=\"190\" height=\"65\" rx=\"9\" fill=\"#e4f0e7\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">三元可行配方</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">比例网格及固定色标</text></g><g class=\"case-flow-node\" data-flow-step=\"3\" data-flow-node=\"compare\" transform=\"translate(880 140)\"><rect width=\"190\" height=\"55\" rx=\"9\" fill=\"#eff3f5\"/><text x=\"95\" y=\"26\" text-anchor=\"middle\" class=\"case-flow-title\">留出误差评价</text><text x=\"95\" y=\"47\" text-anchor=\"middle\" class=\"case-flow-detail\">性能非采收率百分点</text></g>\n </svg></div><figcaption>详细原理、数据图表与计算见下方各步骤。<span data-flow-instruction></span></figcaption></figure><div class=\"xl-step-nav\" role=\"tablist\" aria-label=\"方法步骤\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"xl-method-0\" data-xl-step=\"0\">01 整理比例与盐度试验</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-1\" data-xl-step=\"1\">02 学习混合响应代理</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-2\" data-xl-step=\"2\">03 枚举单纯形并查成本</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"xl-method-3\" data-xl-step=\"3\">04 比较可行性能与基线</button></div><article class=\"xl-method-step\" id=\"xl-method-0\" data-xl-panel=\"0\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">01 / 4</span><h3>整理比例与盐度试验</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>每批试验保留A、B比例与盐度，C比例由1−A−B确定。训练与留出按不同试验批次生成，响应指数有独立噪声。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F1：整理比例与盐度试验的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 1｜整理比例与盐度试验</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：每批试验保留A、B比例与盐度，C比例由1−A−B确定。训练与留出按不</text><text x=\"42\" y=\"113\" font-size=\"16\">同试验批次生成，响应指数有独立噪声。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：140批训练、45批测试与固定比例约束</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：A、B为虚构母液，C为载液，用三元比例练习筛选。</text></g></svg><figcaption>图 F1：整理比例与盐度试验的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>140批训练、45批测试与固定比例约束</p></div><div><b>理解这一步</b><p>A、B为虚构母液，C为载液，用三元比例练习筛选。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-1\" data-xl-panel=\"1\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">02 / 4</span><h3>学习混合响应代理</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>二次回归包括A²、B²、AB和盐度交互，学习同一比例在不同盐度下的响应变化。训练均值是独立对照。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F2：学习混合响应代理的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 2｜学习混合响应代理</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：二次回归包括A²、B²、AB和盐度交互，学习同一比例在不同盐度下的响</text><text x=\"42\" y=\"113\" font-size=\"16\">应变化。训练均值是独立对照。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：冻结性能代理和留出MAE</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：性能栏显示代理预测值，留出误差单独列出。</text></g></svg><figcaption>图 F2：学习混合响应代理的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>冻结性能代理和留出MAE</p></div><div><b>理解这一步</b><p>性能栏显示代理预测值，留出误差单独列出。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-2\" data-xl-panel=\"2\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">03 / 4</span><h3>枚举单纯形并查成本</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>以0.05为比例步长枚举231点，每个点满足比例总和1。按单价9、6、1.5元/L直接加权计算成本，超预算点灰显。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F3：枚举单纯形并查成本的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 3｜枚举单纯形并查成本</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：以0.05为比例步长枚举231点，每个点满足比例总和1。按单价9、6</text><text x=\"42\" y=\"113\" font-size=\"16\">、1.5元/L直接加权计算成本，超预算点灰显。</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：三元配方图上的真实可行域</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：先按成本约束筛选，再在可行配方中比较性能。</text></g></svg><figcaption>图 F3：枚举单纯形并查成本的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>三元配方图上的真实可行域</p></div><div><b>理解这一步</b><p>先按成本约束筛选，再在可行配方中比较性能。</p></div></div></article><article class=\"xl-method-step\" id=\"xl-method-3\" data-xl-panel=\"3\"><div class=\"xl-step-heading\"><span class=\"xl-kicker\">04 / 4</span><h3>比较可行性能与基线</h3></div><div class=\"xl-action-copy\"><b>输入与动作</b><p>只在可行点中按预测性能排序，圈出当前最佳；固定0.3/0.3/0.4配方以方块标出。改变盐度或预算后重新计算图中颜色与最优点；色标固定−20–80，便于跨盐度比较。三元图上顶A、左下C、右下B，20%网格用于读比例，单点步长5%。</p></div><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"图 F4：比较可行性能与基线的动作、产物和检查点。\"><rect width=\"760\" height=\"300\" rx=\"14\" fill=\"#f0f5f4\"/><g font-family=\"system-ui,Microsoft YaHei\" font-size=\"17\" fill=\"#254755\"><text x=\"28\" y=\"36\" font-size=\"21\">步骤 4｜比较可行性能与基线</text><rect x=\"25\" y=\"60\" width=\"710\" height=\"67\" rx=\"10\" fill=\"#dcebe7\"/><text x=\"42\" y=\"89\" font-size=\"16\">动作：只在可行点中按预测性能排序，圈出当前最佳；固定0.3/0.3/0.4</text><text x=\"42\" y=\"113\" font-size=\"16\">配方以方块标出。改变盐度或预算后重新计算图中颜色与最优点；色标固定0–8</text><path d=\"M380 132V158\" stroke=\"#247e85\" stroke-width=\"3\"/><text x=\"360\" y=\"151\" font-size=\"19\">↓</text><text x=\"28\" y=\"187\" font-size=\"18\">产物：当前候选、固定配方和约束计数</text><text x=\"28\" y=\"235\" font-size=\"16\">检查：固定配方成本为5.10元/L，与同一预算逐项比较。</text></g></svg><figcaption>图 F4：比较可行性能与基线的动作、产物和检查点。</figcaption></figure><div class=\"xl-products\"><div><b>得到什么</b><p>当前候选、固定配方和约束计数</p></div><div><b>理解这一步</b><p>固定配方成本为5.10元/L，与同一预算逐项比较。</p></div></div></article><div class=\"xl-next\"><button type=\"button\" data-xl-tab=\"lab\">用当前数据检验这条流程 →</button></div></div>"
      },
      "lessonHTML": "<div class=\"xl-method\"><div class=\"xl-opening\"><span class=\"xl-kicker\">沿着资料走一遍</span><h2>提高性能时，怎样同时看见配方成本与盐度影响？</h2><p>图中的分支对应方法和基线；下面每一步都说明输入、动作与产物，进入演示后可改变条件查看实际数值。</p></div><figure class=\"case-flow-overview case-flow-compact study-workflow-overview\" data-flow-scene=\"e3\" style=\"margin:18px 0 24px;padding:12px 14px;background:#fafbf9;border:1px solid #e0e6e0;border-radius:8px;min-width:0;max-width:100%;box-sizing:border-box\"><style>.case-flow-compact h3{font-size:19px!important;line-height:1.6!important;color:#355a50;margin:0 0 5px!important}.case-flow-compact .case-flow-scroll{overflow-x:auto;max-width:1000px;margin:0 auto;overscroll-behavior-x:contain}.case-flow-compact svg{display:block;width:100%;min-width:940px;height:auto;font-family:system-ui,Microsoft YaHei,sans-serif}.case-flow-compact .case-flow-title{font-size:19px;font-weight:600;fill:#355a50}.case-flow-compact .case-flow-detail{font-size:14px;fill:#6b8078}.case-flow-compact .case-flow-edge{font-size:13px;fill:#70877d;paint-order:stroke;stroke:#fafbf9;stroke-width:4px}.case-flow-compact .case-flow-node rect,.case-flow-compact .case-flow-node polygon{stroke:#b7c8bc;stroke-width:1}.case-flow-compact .case-flow-node[role=button]{cursor:pointer;outline:none}.case-flow-compact .case-flow-node[aria-current=true] rect,.case-flow-compact .case-flow-node[aria-current=true] polygon,.case-flow-compact .case-flow-node:focus rect,.case-flow-compact .case-flow-node:focus polygon{stroke:#347a65;stroke-width:2}.case-flow-compact svg text{pointer-events:none}.case-flow-compact figcaption{font-size:14px!important;line-height:1.7!important;color:#75877b;margin:4px 0 0!important}</style><h3>本例方法概览</h3><div class=\"case-flow-scroll\" tabindex=\"0\" aria-label=\"流程概览，可横向滚动\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 250\" role=\"group\" aria-label=\"配方成本与盐度\"><defs><marker id=\"cf-e3\" markerWidth=\"7\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\"><path d=\"M0 0