l-line);margin-top:18px!important;font-size:17px;color:#3d4650!important;min-height:1.8em}\n.xl-update{font-size:14px;color:#7d6c67;display:block;margin-top:10px}\n.xl-lesson #status{font-size:16px;border-radius:12px;background:#fff7f2;border:1px solid #edd8ce;color:#754b45;padding:12px 16px}\n.xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid{gap:18px}\n.xl-lesson .toolbar{border-radius:18px;background:#fff9f5;border:1px solid var(--xl-line);padding:18px}\n.xl-lesson .charts{gap:24px}.xl-lesson .charts figure{min-width:0;border:1px solid #eee8e2;background:#fff;border-radius:16px;padding:16px;margin:0}\n.xl-lesson .charts canvas{display:block;width:100%;height:auto;max-width:100%}\n.xl-lesson .metric strong,.xl-lesson .metrics strong{color:#a52a31}.xl-lesson .metric>div{border-radius:13px;background:#faf6f1;border:1px solid #e8ded5;color:#514b4b}\n.xl-lesson table{font-size:16px}.xl-lesson th{background:#f5eee8;color:#54474a}.xl-lesson td,.xl-lesson th{padding:11px 13px;border-color:#e9e2da}\n.xl-lesson a{color:#a32c34}.xl-lesson .scroll,.xl-lesson .table-wrap,.xl-lesson .table-scroll{max-width:100%;overflow:auto}\n.xl-fold{margin:18px 0;background:#fcfaf7;border:1px solid #e7ded7;border-radius:15px;padding:14px 18px}\n.xl-fold>summary{cursor:pointer;font-size:16px;color:#665658;line-height:1.8}.xl-fold[open]>summary{margin-bottom:18px}\n.xl-fold>*:not(summary){box-shadow:none}.xl-save{display:flex;justify-content:flex-end;padding:20px 0;margin-top:20px}\n.xl-save button{font-size:15px;color:#7a6264;background:transparent;padding:8px 13px;min-height:38px}\n.xl-lesson .learning-task,.xl-lesson #lab>.reading-block:first-child{display:none}\n.xl-parent .sr-eyebrow,.xl-parent .sr-toc button[aria-current=\"true\"]{color:var(--xl-red)}\n.xl-parent .sr-demo-bar{background:#fff9f5;border-color:#e5d6cd}.xl-parent .sr-demo-bar strong{color:#332f36}\n.xl-parent .sr-lede,.xl-parent .sr-toc{background:#fff9f5;border-color:#e5d6cd}\n.xl-lesson [hidden],.xl-parent [hidden]{display:none!important}\n@media(max-width:760px){\n .xl-lesson>header{margin:10px 10px 0;padding:22px 20px 16px;border-radius:19px}.xl-lesson>main{margin:14px 10px 60px;padding:0}\n .xl-lesson>header nav{gap:6px}.xl-lesson>header nav button{font-size:16px;padding:10px}\n .xl-chapter,.xl-opening,.xl-method-step,.xl-lab-guide,.xl-lesson .card,.xl-lesson .panel,.xl-lesson .plot-grid>article,.xl-lesson .reading-block{padding:20px 18px;border-radius:17px}\n .xl-opening h2{font-size:23px}.xl-reading-path{grid-template-columns:1fr}.xl-products{grid-template-columns:1fr}\n .xl-lesson .charts,.xl-lesson .maps,.xl-lesson .split,.xl-lesson .workspace,.xl-lesson .two-columns,.xl-lesson .plot-grid,.xl-lesson .analysis{grid-template-columns:minmax(0,1fr)!important;gap:18px}\n .xl-lesson .controls,.xl-lesson .controlgrid,.xl-lesson .control-grid,.xl-lesson .condition-grid{grid-template-columns:minmax(0,1fr)!important}\n .xl-lesson .metric,.xl-lesson .metrics,.xl-lesson .strip{grid-template-columns:repeat(2,minmax(0,1fr));flex-wrap:wrap}\n .xl-step-heading{display:block}.xl-step-heading h3{margin-top:8px}.xl-step-nav{gap:6px}.xl-step-nav button{font-size:15px;padding:9px 11px}\n .xl-lesson .charts figure{padding:7px}.xl-lesson .chart,.xl-lesson .plot,.xl-lesson .chart-shell,.xl-lesson .svg-frame{max-width:100%;overflow:auto}\n .xl-knowledge svg,.xl-method-step svg{max-height:240px}.xl-method .case-flow-overview{padding:10px;overflow:auto}.xl-method .case-flow-overview svg{min-width:650px}\n .xl-diagram svg{min-width:680px;max-height:none}.xl-data-plot>svg,.xl-data-plot>canvas{min-width:760px;max-width:none!important;width:760px!important;height:auto}\n .xl-diagram-hint{display:block;position:sticky;left:0;font-size:14px;color:#867476;line-height:1.8;padding:6px 0 2px}\n .xl-lesson .action-row,.xl-lesson .actions,.xl-lesson .bottom-actions{flex-wrap:wrap}.xl-lesson .view-tools{flex-wrap:wrap}\n}\n@media(prefers-reduced-motion:reduce){.xl-lesson *,.xl-parent *{scroll-behavior:auto!important;transition:none!important}}\n</style><div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>先读GR、电阻率等曲线各测量什么，再讨论互补关系。</p><p>自然伽马GR以API表示天然放射性变化；深电阻率Rt用Ω·m表示地层电性；体积密度RHOB用g/cm³表示地层整体密度。它们都按井深对齐，但测量的是不同物理量。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"密度缺口的教学示例\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">MD / m ↓</text><path d=\"M85.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">2.2</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1500</text><path d=\"M243.75000000000017 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"243.75000000000017\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">2.3</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1502</text><path d=\"M402.50000000000034 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.50000000000034\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">2.4</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1504</text><path d=\"M561.2499999999998 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"561.2499999999998\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">2.5</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1506</text><path d=\"M720.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">2.6</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1508</text><path d=\"M275.50,55.00L275.50,101.25L275.50,147.50L561.25,159.06L561.25,193.75L561.25,240.00\" stroke=\"#929ca3\" stroke-width=\"3\" fill=\"none\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#929ca3\">封存原值</text><path d=\"M275.50,101.25L561.25,240.00\" stroke=\"#c07648\" stroke-width=\"3\" fill=\"none\"/><text x=\"305\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#c07648\">仅用两端插值</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">RHOB / g·cm⁻³</text></svg><figcaption>图B1｜端点直线可能跨过真实层界。假设1502—1508 m为缺口；橙线把两个端点连直，而灰色封存原值在内部跳变。灰色只在评价时查看，不能充当修复特征。</figcaption></figure></div>"
        },
        {
          "no": 2,
          "en": "PRINCIPLE",
          "title": "端点插值会忽略缺口中的地层变化",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>比较缺口端点与内部地层变化，理解直线插值为何可能遗漏变化。</p><p>线性插值只用缺口两端的密度连接直线。如果缺口跨越地层边界，两端之间并不一定平滑。辅助曲线可能揭示缺口内部的变化，为估计密度提供额外信息。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 320\" role=\"img\" aria-label=\"仍然可见的GR\"><rect width=\"800\" height=\"320\" fill=\"#fafcf9\"/><text x=\"85\" y=\"25\" font-size=\"17\" text-anchor=\"start\" fill=\"#243740\">MD / m ↓</text><path d=\"M85.0 55V240M85 55.0H720\" stroke=\"#dce5dd\"/><text x=\"85.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">0</text><text x=\"73\" y=\"60.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1500</text><path d=\"M243.75 55V240M85 101.25H720\" stroke=\"#dce5dd\"/><text x=\"243.75\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">35</text><text x=\"73\" y=\"106.25\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1502</text><path d=\"M402.5 55V240M85 147.5H720\" stroke=\"#dce5dd\"/><text x=\"402.5\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">70</text><text x=\"73\" y=\"152.5\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1504</text><path d=\"M561.25 55V240M85 193.75H720\" stroke=\"#dce5dd\"/><text x=\"561.25\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">105</text><text x=\"73\" y=\"198.75\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1506</text><path d=\"M720.0 55V240M85 240.0H720\" stroke=\"#dce5dd\"/><text x=\"720.0\" y=\"263\" font-size=\"14\" text-anchor=\"middle\" fill=\"#243740\">140</text><text x=\"73\" y=\"245.0\" font-size=\"14\" text-anchor=\"end\" fill=\"#243740\">1508</text><path d=\"M248.29,55.00L248.29,101.25L248.29,147.50L552.18,159.06L552.18,193.75L552.18,240.00\" stroke=\"#14796f\" stroke-width=\"3\" fill=\"none\"/><text x=\"95\" y=\"300\" font-size=\"14\" text-anchor=\"start\" fill=\"#14796f\">GR始终可见</text><text x=\"400\" y=\"283\" font-size=\"16\" text-anchor=\"middle\" fill=\"#243740\">GR / API</text></svg><figcaption>图B2｜辅助曲线能保留缺口内的地层线索。相同深度的GR已发生持续改变，说明端点间不一定平滑。近邻法用可见GR/logRt找独立训练样本，平均其RHOB；估计值身份始终保留。</figcaption></figure></div>"
        },
        {
          "no": 3,
          "en": "INTERPRETATION",
          "title": "修复值与原测量值必须区分",
          "html": "<div class=\"xl-knowledge\"><p class=\"xl-read\"><b>看图时留意</b>用独立留出井段检查修复，并始终标出缺口范围。</p><p>模型在独立训练井中寻找GR和logRt相近的样本，把这些样本的密度均值作为缺口估计。测试井被遮蔽的密度不会进入近邻搜索；修复后再与封存原值比较，只在缺口内计算RMSE和MAE。</p><p>显示原值用于核对，不会改变模型输出。曲线修复结果保留估计身份，不能当成仪器重新测量。</p><p class=\"sub\">专业资料：<a href=\"https://www.slb.com/-/media/files/oilfield-review/defining-log-interpretation.ashx\" target=\"_blank\" rel=\"noopener\">SLB｜Basic well log interpretation</a>；<a href=\"https://www.epa.gov/environmental-geophysics/logging-techniques-and-tools-nuclear-logging\" target=\"_blank\" rel=\"noopener\">US EPA｜Nuclear logging</a>。本例采用固定种子教学数据；数据结构、单位与评价范围在演示中列出。</p><aside class=\"learning-task\"><h3>先做一个可核对实验</h3><p>起点100、长度38让缺口跨越地层改变；再将起点10、长度20放到同层内，逐次重算比较插值与近邻RMSE。切换仅GR后对照结果，说明辅助Rt提供的信息；平滑同层缺口下插值可能更好。</p></aside></div>"
        }
      ],
      "lessonOpening": "<div class=\"xl-opening\"><span class=\"xl-kicker\">认识问题 · 再看方法</span><h2>缺测曲线的修复值来自其他观测关系；要把原始测量、缺口和估计值明确区分。</h2><p>从一段缺测井段出发，把专业含义、图中位置和计算结果连起来。</p><div class=\"xl-reading-path\"><a href=\"#xl-chapter-0\" data-xl-chapter=\"0\"><span>01</span>先认清三条曲线测量什么</a><a href=\"#xl-chapter-1\" data-xl-chapter=\"1\"><span>02</span>端点插值会忽略缺口中的地层变化</a><a href=\"#xl-chapter-2\" data-xl-chapter=\"2\"><span>03</span>修复值与原测量值必须区分</a></div></div>"
    },
    "workflow": {
      "label": "案例流程",
      "title": "密度曲线缺了一段时，邻近端点和其他测量分别能提供什么信息？",
      "lead": [
        "密度曲线缺了一段时，邻近端点和其他测量分别能提供什么信息？",
        "按下列手算例理解运算，再进入示范改变同一数据上的模型和基线。"
      ],
      "stats": [
        [
          "步骤",
          "3"
        ],
        [
          "运行",
          "离线"
        ]
      ],
      "steps": [
        {
          "name": "封存并遮蔽缺口",
          "role": "步骤1",
          "do": "测试井按起点和长度把RHOB置为空。",
          "effect": "可见GR/Rt与带缺口RHOB",
          "trap": "封存原值不进入修复函数。"
        },
        {
          "name": "寻找可比训练样本",
          "role": "步骤2",
          "do": "固定使用GR/100与logRt的欧氏距离，检索k近邻后平均密度。",
          "effect": "重建曲线与线性基线",
          "trap": "关闭Rt后只按GR近邻搜索。"
        },
        {
          "name": "只评价遮蔽区",
          "role": "步骤3",
          "do": "解封原值，计算同一缺口的两种误差。",
          "effect": "缺口点数、RMSE和MAE",
