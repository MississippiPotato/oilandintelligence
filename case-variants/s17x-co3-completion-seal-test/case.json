le\">20</text><path d=\"M100 77.5H848\" stroke=\"#DDD5CB\"/><text x=\"88\" y=\"83.5\" text-anchor=\"end\">0.010</text><text x=\"661\" y=\"241\" text-anchor=\"middle\">26</text><path d=\"M100 32H848\" stroke=\"#DDD5CB\"/><text x=\"88\" y=\"38\" text-anchor=\"end\">0.020</text><text x=\"848\" y=\"241\" text-anchor=\"middle\">32</text><path d=\"M100 32V214H848\" stroke=\"#6A5C55\" fill=\"none\"/><text x=\"474\" y=\"268\" text-anchor=\"middle\">试验时间 / min</text><text transform=\"translate(25 123) rotate(-90)\" text-anchor=\"middle\">残差 / MPa</text><path d=\"M100 123H848\" stroke=\"#B08A4A\" stroke-dasharray=\"5 4\"/><circle cx=\"100\" cy=\"153.5379577373181\" r=\"3\" fill=\"#55768B\"/><circle cx=\"115.58333333333333\" cy=\"136.25499097937865\" r=\"3\" fill=\"#55768B\"/><circle cx=\"131.16666666666666\" cy=\"95.19390765541405\" r=\"3\" fill=\"#55768B\"/><circle cx=\"146.75\" cy=\"87.41357270741753\" r=\"3\" fill=\"#55768B\"/><circle cx=\"162.33333333333331\" cy=\"106.24012734284065\" r=\"3\" fill=\"#55768B\"/><circle cx=\"177.91666666666669\" cy=\"71.90412171885939\" r=\"3\" fill=\"#55768B\"/><circle cx=\"193.5\" cy=\"123.26811095188607\" r=\"3\" fill=\"#55768B\"/><circle cx=\"209.08333333333334\" cy=\"191.74535690724935\" r=\"3\" fill=\"#55768B\"/><circle cx=\"224.66666666666666\" cy=\"130.67619872928714\" r=\"3\" fill=\"#55768B\"/><circle cx=\"240.25\" cy=\"153.96050257995375\" r=\"3\" fill=\"#55768B\"/><circle cx=\"255.83333333333334\" cy=\"148.39985183543217\" r=\"3\" fill=\"#55768B\"/><circle cx=\"271.41666666666663\" cy=\"65.92901175325306\" r=\"3\" fill=\"#55768B\"/><circle cx=\"287\" cy=\"121.22388324400383\" r=\"3\" fill=\"#55768B\"/><circle cx=\"302.5833333333333\" cy=\"158.47921114667793\" r=\"3\" fill=\"#55768B\"/><circle cx=\"318.1666666666667\" cy=\"161.2187933504835\" r=\"3\" fill=\"#55768B\"/><circle cx=\"333.75\" cy=\"166.89422211539085\" r=\"3\" fill=\"#55768B\"/><circle cx=\"349.3333333333333\" cy=\"110.64007819289382\" r=\"3\" fill=\"#55768B\"/><circl