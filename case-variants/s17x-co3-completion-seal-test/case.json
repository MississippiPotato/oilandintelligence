    "workflow": {
      "label": "计算流程",
      "title": "从观测到可复核判断",
      "lead": [
        "先确定受试隔离段与闭阀时间窗，再校准温漂与系统顺应性；从同一压力温度记录估计漏率，保留待复核、缺测和未闭阀的负结果。"
      ],
      "steps": [
        {
          "name": "校准温漂与体积响应",
          "role": "输入与操作",
          "do": "输入：6次无漏温漂试验、4次本次加液校准；动作：校准升温1 K引起的MPa压变（β），以及增压1 MPa需要补入的L体积（Ceff），保留校准离散度。",
          "effect": "MPa/K与L/MPa校准量",
