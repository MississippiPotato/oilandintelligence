5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"218.3339968866744\" cy=\"132.42228797338086\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"266.8200865478882\" cy=\"102.6087006049506\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"363.7973825552991\" cy=\"79.12429585595817\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"460.7748155292608\" cy=\"66.89001478928921\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"557.7522488427292\" cy=\"62.77173078248583\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"654.7296821570396\" cy=\"60.38586368117538\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"112.38229990403497\" cy=\"283.3509781810327\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"152.0423384186571\" cy=\"206.20943646097794\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"195.03160378861946\" cy=\"150.60715868620042\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"260.255126358236\" cy=\"110.58542786277448\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"325.55650687014736\" cy=\"93.12890653865222\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"456.1672202328143\" cy=\"81.78993129490127\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"586.7781464696643\" cy=\"77.41976453839914\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"717.3890732341781\" cy=\"73.7178738443202\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><circle cx=\"848\" cy=\"75.07587049279547\" r=\"3.5\" fill=\"#B08A4A\" opacity=\".55\"/><path d=\"M90.00,304.00 L97.42,303.35 L99.32,303.35 L101.68,303.07 L104.57,303.07 L105.40,303.07 L108.11,294.92 L110.75,294.92 L112.38,290.66 L113.45,290.66 L117.70,279.87 L122.50,274.06 L125.56,274.06 L126.63,262.93 L134.45,253.46 L137.67,253.46 L137.92,241.49 L140.20,241.49 L149.99,221.98 L152.04,214.85 L157.91,214.85 L159.73,214.85 L161.89,214.85 L169.90,188.68 L185.02,180.55 L185.33,180.55 L186.10,180.55 L193.32,171.64 L195.03,165.00 L210.32,165.00 L218.33,141.15 L220.69,141.15 L228.74,141.15 L234.54,141.15 L235.61,132.00 L260.26,114.59 L264.15,114.59 L266.82,109.37 L286.20,105.66 L291.42,98.79 L299.57,98.79 L325.56,94.36 L336.78,87.53 L362.15,81.77 L363.80,81.77 L387.37,79.02 L432.88,73.99 L456.17,73.99 L460.77,72.17 L503.61,68.04 L557.75,68.04 L586.78,68.04 L654.73,67.13 L717.39,67.13 L848.00,67.13 \" fill=\"none\" stroke=\"#B8242A\" stroke-width=\"3\"/></g></svg><div class=\"vx-legend\"><span><i style=\"background:#B8242A\"></i>单调分段拟合</span><span><i style=\"background:#B08A4A\"></i>12训练批次的108个合成压碎读数</span></div></div><p class=\"ct-readout\" data-ct-result>Ea = 30 kJ/mol；验证强度 MAE 0.942 MPa（36/36点）。示例 WX04 在目标 10 MPa 时：22.24 h。当前调参是教学比较，正式评分仍冻结 Ea = 30。</p></section><article class=\"vx-card\"><h2>3 对新程序预测，再计算与目标的首次交点</h2><p>输入只有时间与温度。将新程序换成等效龄期后，在训练得到的单调折线上插值。目标高于72 h预测曲线时返回未达到。</p><h2>4 最后揭示独立参考并比较基线</h2><p>主模型和“忽略温度、沿用50°C时间曲线”的基线使用相同留出批次、目标与误差分母。强度MAE按有效合成压碎读数统计；时间MAE只在两边都达到目标的批次上计算，同时列出提前、漏判、假达到与参考未达标数量。</p></article>"
  }
}
