{
  "name": "s17-mudlogging-lab",
  "version": "1.9.2-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-project": "node tools/prepare.mjs",
    "build": "node tools/build.mjs",
    "test": "node checks/verify-four-exhibits.mjs && node checks/run-four-calculations.mjs",
    "verify-delivery": "node checks/verify-four-delivery.mjs",
    "verify-guide": "node checks/verify-four-delivery.mjs",
    "package": "node checks/verify-four-delivery.mjs --skip-packages && node tools/package-four-exhibits.mjs && node checks/verify-four-delivery.mjs",
    "serve": "node tools/serve.mjs",
    "accept": "node tools/accept-four-exhibits.mjs",
    "build:m2": "node tools/build.mjs --m2-only",
    "verify:m2": "node checks/verify.mjs --no-write",
    "accept:m2": "node checks/browser-m2-four-smoke.mjs",
    "package:m2": "node tools/package-m2-exhibit.mjs",
    "build:four": "node tools/build.mjs",
    "capture:four-flow": "node tools/capture-four-flow.mjs",
    "accept:four": "node checks/browser-four-exhibits.mjs --open && node checks/browser-four-exhibits.mjs && node checks/browser-m2-four-smoke.mjs"
  }
