{
  "name": "s17-mudlogging-lab",
  "version": "1.9.0-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-project": "node tools/prepare.mjs",
    "build": "node tools/build.mjs && node tools/build-expansion.mjs --require-all",
    "test": "node checks/verify.mjs && node checks/verify-mandatory.mjs && node checks/verify-enhancements.mjs && node checks/verify-expansion-source.mjs --require-all && node checks/verify-study.mjs && node checks/full-coverage-review.mjs",
    "verify-delivery": "node checks/verify-full-delivery.mjs",
    "verify-guide": "node checks/verify-full-delivery.mjs",
    "package": "node checks/verify-full-delivery.mjs --no-write && node tools/package.mjs --guide-preview",
