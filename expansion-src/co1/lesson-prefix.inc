  function renderReviewHistory(){const labels={current:'本次人工意见',history:'历史运行意见',stale:'输入已变更的历史意见'};$('#review-history').innerHTML=state.reviews.map(r=>`<p><b>${esc(r.subject)}</b> · run ${r.runId} · ${labels[r.recordStatus]}<br>${esc(r.opinion)}：${esc(r.note)}<br>当时模型：${esc(r.originalPrediction)}</p>`).join('');}
