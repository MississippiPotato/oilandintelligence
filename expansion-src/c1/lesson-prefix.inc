ext x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">后到窗</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">42–74点</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">可见特征</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">4维输入</text></g></svg>"}, {"name": "先按整井分组，再学习", "input": "18 口训练井、6 口验证井、4 口测试井", "action": "同一井的全部深度点只进入一个集合；测试扰动仅作用于测试井", "output": "864 / 288 / 192 个采样点，井号互不重叠", "trap": "邻近深度点高度相似，随机拆点会把同一条曲线泄漏到测试。", "figure": "<svg viewBox=\"0 0 880 240\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"整井隔离数据划分\"><rect width=\"880\" height=\"240\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"35\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">训练：18井 / 864点</text><rect x=\"315\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"330\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">验证：6井 / 288点</text><rect x=\"595\" y=\"50\" width=\"245\" height=\"85\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"610\" y=\"98.5\" font-size=\"19\" fill=\"#223e46\">测试：4井 / 192点</text><text x=\"55\" y=\"195\" font-size=\"19\" fill=\"#223e46\">拟合均值、尺度和样本库</text><text x=\"335\" y=\"195\" font-size=\"19\" fill=\"#223e46\">选择 k 和基线阈值</text><text x=\"615\" y=\"195\" font-size=\"19\" fill=\"#223e46\">只推理，再独立评分</text></g></svg>"}, {"name": "从波形计算四维特征", "input": "当前可见波形，不含类别字段", "action": "计算早到 RMS、后到 RMS、后/早 RMS 比、后到一阶差分 RMS", "output": "可解释的声幅强弱、波列能量与起伏特征", "trap": "波形由教学生成器产生；分类器不能读取生成器内部的胶结类别。", "figure": "<svg viewBox=\"0 0 880 250\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"四种实际计算特征\"><rect width=\"880\" height=\"250\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"35\" y=\"40\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"78.5\" font-size=\"19\" fill=\"#223e46\">早到 RMS = √mean(a²)</text><rect x=\"485\" y=\"40\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"500\" y=\"78.5\" font-size=\"19\" fill=\"#223e46\">后到 RMS = √mean(b²)</text><rect x=\"35\" y=\"145\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"50\" y=\"183.5\" font-size=\"19\" fill=\"#223e46\">相对能量 = RMS(b) / RMS(a)</text><rect x=\"485\" y=\"145\" width=\"360\" height=\"65\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"500\" y=\"183.5\" font-size=\"19\" fill=\"#223e46\">起伏 = √mean((bₜ − bₜ₋₁)²)</text></g></svg>"}, {"name": "真实近邻投票与拒判", "input": "训练标准化参数、训练特征库、当前四维特征", "action": "验证集从 k=3/5/9 选优；按距离倒数加权投票", "output": "响应类型、实际近邻、投票支持度与待复核原因", "trap": "投票支持度不是现场概率；平均邻距超过 4.5 或低于支持度门槛时拒判。", "figure": "<svg viewBox=\"0 0 880 220\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"近邻分类\"><rect width=\"880\" height=\"220\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"25\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"40\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">训练标准化</text><path d=\"M184 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"30\" y=\"166\" font-size=\"16\" fill=\"#223e46\">训练拟合</text><rect x=\"198\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"213\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">全4维距离</text><path d=\"M357 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"203\" y=\"166\" font-size=\"16\" fill=\"#223e46\">欧氏距离</text><rect x=\"371\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"386\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">k个近邻</text><path d=\"M530 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"376\" y=\"166\" font-size=\"16\" fill=\"#223e46\">验证选k</text><rect x=\"544\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">加权投票</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">1/max(0.05,d)</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">复核门槛</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">支持度/距离</text></g></svg>"}, {"name": "同井对照、误差定位与复核", "input": "模型/阈值预测；独立评价真值仅用于计分", "action": "在同一 192 点上计算带拒判列的混淆矩阵；保留人工意见", "output": "宏 F1、每类召回、覆盖率、接受集错误率、当前证据 JSON", "trap": "拒判保留在总分母；人工意见单独保存，不修改模型原始成绩。", "figure": "<svg viewBox=\"0 0 880 220\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"评价与复核闭环\"><rect width=\"880\" height=\"220\" rx=\"18\" fill=\"#f4f7f5\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" font-size=\"19\" fill=\"#223e46\"><rect x=\"25\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"40\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">共享测试点</text><path d=\"M184 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"30\" y=\"166\" font-size=\"16\" fill=\"#223e46\">192点</text><rect x=\"198\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"213\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">模型 / 阈值</text><path d=\"M357 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"203\" y=\"166\" font-size=\"16\" fill=\"#223e46\">相同输入</text><rect x=\"371\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"386\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">独立真值</text><path d=\"M530 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"376\" y=\"166\" font-size=\"16\" fill=\"#223e46\">仅评价使用</text><rect x=\"544\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"559\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">误差深度图</text><path d=\"M703 91h13m-10 -7l10 7 -10 7\" fill=\"none\" stroke=\"#477f80\" stroke-width=\"3\"/><text x=\"549\" y=\"166\" font-size=\"16\" fill=\"#223e46\">选中定位</text><rect x=\"717\" y=\"55\" width=\"155\" height=\"72\" rx=\"12\" fill=\"#e2ece9\"/><text x=\"732\" y=\"97.0\" font-size=\"19\" fill=\"#223e46\">人工与导出</text><text x=\"722\" y=\"166\" font-size=\"16\" fill=\"#223e46\">保留原预测</text></g></svg>"}], "sources": [{"title": "SLB Oilfield Glossary · cement bond log", "url": "https://glossary.slb.com/en/terms/c/cement_bond_log"}, {"title": "SLB Oilfield Glossary · variable-density log", "url": "https://glossary.slb.com/en/terms/v/variable-density_log"}, {"title": "SLB · Cement bond logging tools", "url": "https://www.slb.com/products-and-services/innovating-in-oil-and-gas/well-construction/well-cementing/cement-evaluation/cement-bond-logging-tools"}, {"title": "scikit-learn · Nearest Neighbors 方法原理", "url": "https://scikit-learn.org/stable/modules/neighbors.html"}]};

  const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)];
  const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt = (x, n=2) => x === null || x === undefined ? '不适用' : Number(x).toFixed(n);
  const pct = x => x === null || x === undefined ? '不适用' : (100*x).toFixed(1)+'%';
  const state = {status:'idle',runId:0,result:null,reviews:[],selected:0,inputRevision:0};
  function status(s, message) {state.status=s;$('#status').dataset.state=s;$('#status').textContent=message;$('#export').disabled=s!=='ready';$('#review').disabled=s!=='ready';}
  function tabs(name) {$$('nav[aria-label="案例内容"] [data-tab]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tab===name)));['background','workflow','lab'].forEach(id=>$('#'+id).hidden=id!==name);}
  $$('nav[aria-label="案例内容"] [data-tab]').forEach(b=>b.onclick=()=>tabs(b.dataset.tab));tabs('background');
  $('#background-content').innerHTML=LESSON.background.map((b,i)=>`<article class="chapter"><div class="number">CONCEPT ${String(i+1).padStart(2,'0')}</div><h2>${esc(b.title)}</h2><figure><div class="diagram" tabindex="0" aria-label="概念图，可横向滚动">${b.html}</div><figcaption>${esc(b.caption)}</figcaption></figure></article>`).join('')+`<aside class="sources"><h3>专业依据与方法资料</h3><ul>${LESSON.sources.map(s=>`<li><a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.title)}</a></li>`).join('')}</ul><p class="small">专业概念依据以上公开资料；图形由本案例重新绘制，默认数据为固定种子的教学合成。</p></aside>`;
  let step=0;
  function showStep(n) {step=n;$('#stepnav').innerHTML=LESSON.steps.map((s,i)=>`<button role="tab" id="step-${i}" aria-controls="step-content" aria-selected="${i===n}" data-step="${i}">${String(i+1).padStart(2,'0')} · ${esc(s.name)}</button>`).join('');const s=LESSON.steps[n];$('#step-content').innerHTML=`<div class="kicker">STEP ${n+1} / ${LESSON.steps.length}</div><h2>${esc(s.name)}</h2><div class="step-io"><div><b>输入</b><p>${esc(s.input)}</p></div><div><b>动作</b><p>${esc(s.action)}</p></div><div><b>产物</b><p>${esc(s.output)}</p></div></div><div class="diagram" tabindex="0" aria-label="步骤图，可横向滚动">${s.figure}</div><p class="step-trap">${esc(s.trap)}</p><div class="review-actions"><button data-prev ${n===0?'disabled':''}>上一步</button><button data-next>${n===LESSON.steps.length-1?'开始交互实验 →':'下一步 →'}</button></div>`;$$('[data-step]').forEach(b=>b.onclick=()=>showStep(Number(b.dataset.step)));$('[data-prev]').onclick=()=>showStep(Math.max(0,step-1));$('[data-next]').onclick=()=>step===LESSON.steps.length-1?tabs('lab'):showStep(step+1);}
  $('#stepnav').onkeydown=e=>{if(!['ArrowDown','ArrowUp','ArrowRight','ArrowLeft','Home','End'].includes(e.key))return;e.preventDefault();const n=e.key==='Home'?0:e.key==='End'?LESSON.steps.length-1:Math.max(0,Math.min(LESSON.steps.length-1,step+(['ArrowDown','ArrowRight'].includes(e.key)?1:-1)));showStep(n);$('#step-'+n).focus();};showStep(0);
  function renderReviewHistory(){const labels={current:'本次人工意见',history:'历史运行意见',stale:'输入已变更的历史意见'};$('#review-history').innerHTML=state.reviews.map(r=>`<p><b>${esc(r.subject)}</b> · run ${r.runId} · ${labels[r.recordStatus]}<br>${esc(r.opinion)}：${esc(r.note)}<br>当时模型：${esc(r.originalPrediction)}</p>`).join('');}
  function retireReviews(kind){state.reviews.forEach(r=>{if(r.recordStatus==='current')r.recordStatus=kind;});renderReviewHistory();}
  function stale() {state.inputRevision++;retireReviews('stale');if(state.status==='idle')return;status('stale','实验条件已变化 · 请重新计算当前结果；先前人工意见保留在历史中');$('#results').classList.add('stale-results');}
  function metric(label,value,note) {return `<div><div class="metric-label">${label}</div><div class="metric-value">${value}</div><div class="metric-note">${note}</div></div>`;}
  function chart(id,width,height) {const c=$('#'+id);c.width=width*2;c.height=height*2;const q=c.getContext('2d');q.scale(2,2);q.fillStyle='#f4f7f5';q.fillRect(0,0,width,height);q.font='16px system-ui,"Microsoft YaHei"';q.textBaseline='middle';q.lineJoin='round';return q;}
  function label(q,x,y,t,color='#546d75',align='left'){q.fillStyle=color;q.textAlign=align;q.fillText(t,x,y);q.textAlign='left';}
  function download() {if(state.status!=='ready')return;const evidence=exportEvidence();const blob=new Blob([JSON.stringify(evidence,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=CASE_ID+'-run-'+state.runId+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),2000);}
  $('#export').onclick=download;
  $('#review').onclick=()=>{if(state.status!=='ready')return;const note=$('#review-note').value.trim();if(!note){$('#review-note').setCustomValidity('请填写当前观察与复核依据');$('#review-note').reportValidity();return;}$('#review-note').setCustomValidity('');const review={runId:state.runId,inputRevision:state.inputRevision,recordStatus:'current',recordedAt:new Date().toISOString(),subject:selectedId(),opinion:$('#review-choice').value,note,originalPrediction:selectedPrediction(),sourceSnapshot:reviewObservation()};state.reviews.push(review);renderReviewHistory();};
  $('#review-note').oninput=()=>$('#review-note').setCustomValidity('');
  g.CaseInspect={snapshot:()=>({sceneId:SCENE_ID,caseId:CASE_ID,status:state.status,runId:state.runId,params:readParams(),metrics:state.status==='ready'?state.result.metrics:null,reviewCount:state.reviews.length,currentReviewCount:state.reviews.filter(r=>r.recordStatus==='current'&&r.runId===state.runId).length})};
