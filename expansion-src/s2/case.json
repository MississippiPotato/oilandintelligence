  "title": "地震相智能分类：从反射纹理认识沉积线索",
  "version": "1.1.1",
  "updated": "2026-10-30",
  "tabs": {
    "background": {
      "label": "专业背景",
      "lede": "振幅相似的地震小窗，为什么会属于不同的反射样式？用原始振幅、空间属性与近邻投票把判断依据展开。",
      "sections": [
        {
          "title": "地震相是什么，为什么与储层有关？",
          "html": "<p>地震波遇到声阻抗变化的界面会发生反射。把相邻位置的反射波形排在一起，就是地震剖面。解释人员依据反射的连续性、倾角、振幅和内部结构，把外观相似的一片划为“地震相”。地震相提供沉积环境的线索，仍需井资料、岩心与地层框架标定，再结合井资料确定相应的沉积与岩性含义。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 190\" role=\"img\" aria-label=\"平行反射：层状、连续\"><rect width=\"720\" height=\"190\" rx=\"10\" fill=\"#f3f7f6\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" fill=\"#28463f\" font-size=\"17\"><polyline points=\"36,54.8 39,53.0 42,51.0 45,48.9 48,46.8 51,44.8 54,43.0 57,41.5 60,40.3 63,39.5 66,39.0 69,39.1 72,39.5 75,40.4 78,41.7 81,43.2 84,45.1 87,47.1 90,49.2 93,51.2 96,53.2 99,55.0 102,56.6 105,57.8 108,58.6 111,59.0 114,58.9 117,58.4 120,57.5 123,56.3 126,54.7 129,52.8 132,50.8 135,48.7 138,46.7 141,44.7 144,42.9 147,41.4 150,40.2 153,39.4 156,39.0 159,39.1 162,39.6 165,40.5 168,41.8 171,43.4 174,45.2 177,47.2 180,49.3 183,51.4 186,53.4 189,55.2 192,56.7 195,57.8 198,58.6 201,59.0 204,58.9 207,58.4 210,57.5 213,56.2 216,54.5 219,52.7 222,50.7 225,48.6 228,46.5 231,44.5 234,42.8 237,41.3 240,40.1 243,39.4 246,39.0 249,39.1 252,39.6 255,40.6 258,41.9 261,43.5 264,45.4 267,47.4 270,49.5 273,51.6 276,53.5 279,55.3 282,56.8 285,57.9 288,58.7 291,59.0 294,58.9 297,58.3 300,57.4 303,56.0 306,54.4 309,52.5 312,50.5 315,48.4 318,46.3 321,44.4 324,42.6\" fill=\"none\" stroke=\"#3c7781\" stroke-width=\"2\"/><polyline points=\"36,84.4 39,82.5 42,80.5 45,78.4 48,76.3 51,74.4 54,72.6 57,71.2 60,70.1 63,69.3 66,69.0 69,69.1 72,69.7 75,70.7 78,72.0 81,73.7 84,75.5 87,77.6 90,79.7 93,81.7 96,83.7 99,85.4 102,86.9 105,88.0 108,88.7 111,89.0 114,88.8 117,88.3 120,87.3 123,85.9 126,84.3 129,82.4 132,80.3 135,78.2 138,76.2 141,74.2 144,72.5 147,71.1 150,70.0 153,69.3 156,69.0 159,69.2 162,69.8 165,70.8 168,72.1 171,73.8 174,75.7 177,77.7 180,79.8 183,81.9 186,83.8 189,85.5 192,87.0 195,88.1 198,88.7 201,89.0 204,88.8 207,88.2 210,87.2 213,85.8 216,84.1 219,82.2 222,80.2 225,78.1 228,76.0 231,74.1 234,72.4 237,71.0 240,69.9 243,69.2 246,69.0 249,69.2 252,69.8 