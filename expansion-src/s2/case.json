,130.3 255,131.5 258,133.0 261,134.8 264,136.8 267,138.9 270,141.0 273,143.0 276,144.8 279,146.4 282,147.6 285,148.5 288,148.9 291,149.0 294,148.5 297,147.7 300,146.5 303,144.9 306,143.1 309,141.1 312,139.0 315,136.9 318,134.9 321,133.1 324,131.6\" fill=\"none\" stroke=\"#3c7781\" stroke-width=\"2\"/><text x=\"365\" y=\"65\" font-size=\"21\">平行反射：层状、连续</text><text x=\"365\" y=\"100\">横轴：地震道（位置）</text><text x=\"365\" y=\"132\">纵轴：双程传播时间 ↓</text></g></svg><figcaption>左图是地震同相轴的概念表达。横轴表示位置，纵轴表示波从地面到界面再返回的双程时间；纵轴按双程时间排列。</figcaption></figure>"
        },
        {
          "title": "先看结构，再看振幅",
          "html": "<p>本演示区分三种教学反射样式：平行连续、倾斜反射、杂乱反射。平行与倾斜可以具有相近振幅，却有不同的空间结构；杂乱反射的邻道相似性较低。它们是用于学习属性分类的反射样式标签，实际沉积相的名称需要地质解释。</p><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 190\" role=\"img\" aria-label=\"倾斜反射：振幅相近，结构不同\"><rect width=\"720\" height=\"190\" rx=\"10\" fill=\"#f3f7f6\"/><g font-family=\"system-ui,Microsoft YaHei,sans-serif\" fill=\"#28463f\" font-size=\"17\"><polyline points=\"36,60.6 39,59.2 42,57.7 45,56.1 48,54.5 51,53.0 54,51.7 57,50.6 60,49.9 63,49.5 66,49.6 69,50.1 72,51.1 75,52.4 78,54.1 81,56.2 84,58.5 87,61.0 90,63.6 93,66.1 96,68.6 99,70.9 102,72.9 105,74.6 108,75.9 111,76.7 114,77.2 117,77.2 120,76.7 123,76.0 126,74.8 129,73.5 132,72.0 135,70.3 138,68.7 141,67.3 144,65.9 147,64.9 150,64.2 153,63.9 156,64.0 159,64.5 162,65.5 165,66.9 168,68.7 171,70.7 174,73.1 177,75.6 180,78.1 183,80.7 186,83.1 189,85.4 192,87.4 195,89.0 198,90.3 201,91.1 204,91.5 207,91.5 210,91.1 213,90.2 216,89.1 219,87.7 222,86.2 225,84.6 228,83.0 231,81.5 234,80.2 237,79.2 240,78.5 243,78.2 246,78.4 249,79.0 252,80.0 255,81.4 258,83.2 261,85.3 264,87.6 267,90.1 270,92.7 273,95.3 276,97.7 279,99.9 282,101.9 285,103.5 288,104.7 291,105.5 294,105.9 297,105.8 300,105.4 303,104.5 306,103.4 309,102.0 312,100.4 315,98.8 318,97.2 321,95.8 324,94.5\" fill=\"none\" stroke=\"#3c7781\" stroke-width=\"2\"/><polyline points=\"36,90.2 39,88.8 42,87.2 45,85.6 48,84.0 51,82.6 54,81.3 57,80.3 60,79.7 63,79.4 66,79.6 69,80.2 72,81.2 75,82.7 78,84.5 81,86.6 84,89.0 87,91.5 90,94.1 93,96.6 96,99.0 99,101.3 102,103.2 105,104.8 108,106.0 111,106.8 114,107.1 117,107.0 120,106.5 123,105.6 126,104.4 129,103.0 132,101.5 135,99.8 138,98.3 141,96.8 144,95.6 147,94.6 150,94.0 153,93.8 156,94.0 159,94.6 162,95.7 165,97.2 168,99.0 171,101.2 174,103.5 177,106.1 180,108.6 183,111.2 186,113.6 189,115.8 192,117.7 195,119.3 198,120.4 201,121.2 204,121.5 207,121.3 210,120.8 213,119.9 216,118.7 219,117.3 222,115.7 225,114.1 228,112.5 231,111.1 234,109.8 237,108.9 240,108.3 243,108.1 246,