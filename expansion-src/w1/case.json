  "tabs": {
    "background": {
      "label": "专业背景",
      "lede": "曲线中的变化是地层边界，还是一个测量尖峰？",
      "judge": [
        {
          "label": "业务问题",
          "value": "先理解测量",
          "desc": "曲线中的变化是地层边界，还是一个测量尖峰？"
        },
        {
          "label": "数据",
          "value": "固定种子教学数据",
          "desc": "训练与测试数据分开"
        },
        {
          "label": "运行",
